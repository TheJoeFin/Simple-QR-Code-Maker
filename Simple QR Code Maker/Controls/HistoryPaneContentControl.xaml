<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.HistoryPaneContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Simple_QR_Code_Maker.Behaviors"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Simple_QR_Code_Maker.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibility" />
    </UserControl.Resources>

    <Grid Padding="24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="HistoryPaneContentControl_HistoryText"
            VerticalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}" />
        <HyperlinkButton
            x:Uid="HistoryPaneContentControl_SaveCurrentQRCodeToHyperlinkButton"
            HorizontalAlignment="Right"
            Command="{x:Bind ViewModel.SaveCurrentStateToHistoryCommand}"
            IsEnabled="{x:Bind ViewModel.CanSaveImage, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <SymbolIcon Symbol="Save" />
                <TextBlock x:Uid="HistoryPaneContentControl_SaveToHistoryText" />
            </StackPanel>
        </HyperlinkButton>
        <TextBlock
            x:Uid="HistoryPaneContentControl_NoHistoryYetSaveOrText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HistoryItems.Count, Converter={StaticResource EmptyCollectionToVisibility}, Mode=OneWay}">
            <interactivity:Interaction.Behaviors>
                <behaviors:ImplicitVisibilityAnimationBehavior />
            </interactivity:Interaction.Behaviors>
        </TextBlock>
        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.HistoryItems, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedHistoryItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{x:Bind ViewModel.HistoryItems.Count, Converter={StaticResource EmptyCollectionToVisibility}, ConverterParameter=true, Mode=OneWay}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ReorderThemeTransition />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryItem">
                    <local:HistoryRowItem Data="{x:Bind}">
                        <local:HistoryRowItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="HistoryPaneContentControl_RemoveMenuItem" Click="RemoveHistoryItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Delete" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </local:HistoryRowItem.ContextFlyout>
                    </local:HistoryRowItem>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
