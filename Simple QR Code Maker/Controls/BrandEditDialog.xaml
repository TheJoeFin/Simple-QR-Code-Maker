<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Simple_QR_Code_Maker.Controls.BrandEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Simple_QR_Code_Maker.Controls"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    xmlns:settingsControls="using:CommunityToolkit.WinUI.Controls"
    x:Uid="BrandEditDialog_Dialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsNameValid, Mode=OneWay}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:FilePathToImageSourceConverter x:Key="FilePathToImage" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <x:Double x:Key="SettingsCardWrapThreshold">320</x:Double>
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">200</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="600"
        Padding="0,0,12,0"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

            <!--  Brand Name  -->
            <settingsControls:SettingsCard x:Uid="BrandEditDialog_BrandNameSettingsCard">
                <settingsControls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8AC;" />
                </settingsControls:SettingsCard.HeaderIcon>
                <TextBox
                    x:Uid="BrandEditDialog_BrandNameTextBox"
                    MinWidth="200"
                    Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </settingsControls:SettingsCard>

            <!--  Foreground color  -->
            <settingsControls:SettingsCard x:Uid="BrandEditDialog_ForegroundColorSettingsCard">
                <settingsControls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </settingsControls:SettingsCard.HeaderIcon>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <controls:ColorPickerButton
                        DefaultImagePath="{x:Bind ViewModel.LogoPath, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IncludeForeground, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Color="{x:Bind ViewModel.ForegroundColor, Mode=TwoWay}" />
                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.IncludeForeground, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </StackPanel>
            </settingsControls:SettingsCard>

            <!--  Background color  -->
            <settingsControls:SettingsCard x:Uid="BrandEditDialog_BackgroundColorSettingsCard">
                <settingsControls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;" />
                </settingsControls:SettingsCard.HeaderIcon>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <controls:ColorPickerButton
                        DefaultImagePath="{x:Bind ViewModel.LogoPath, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IncludeBackground, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}" />
                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.IncludeBackground, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </StackPanel>
            </settingsControls:SettingsCard>

            <!--  Error correction  -->
            <settingsControls:SettingsCard x:Uid="BrandEditDialog_ErrorCorrectionSettingsCard">
                <settingsControls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D8;" />
                </settingsControls:SettingsCard.HeaderIcon>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.AllCorrectionLevels, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedCorrectionIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IncludeErrorCorrection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ErrorCorrectionOptions">
                                <TextBlock Text="{x:Bind Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.IncludeErrorCorrection, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </StackPanel>
            </settingsControls:SettingsCard>

            <!--  Frame  -->
            <settingsControls:SettingsExpander x:Uid="BrandEditDialog_DesignSettingsExpander" IsExpanded="{x:Bind ViewModel.IncludeFrame, Mode=OneWay}">
                <settingsControls:SettingsExpander.HeaderIcon>
                    <SymbolIcon RenderTransformOrigin="0.5,0.5" Symbol="CalendarDay">
                        <SymbolIcon.RenderTransform>
                            <ScaleTransform ScaleY="-1" />
                        </SymbolIcon.RenderTransform>
                    </SymbolIcon>
                </settingsControls:SettingsExpander.HeaderIcon>
                <settingsControls:SettingsExpander.Content>
                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.IncludeFrame, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </settingsControls:SettingsExpander.Content>
                <settingsControls:SettingsExpander.Items>
                    <settingsControls:SettingsCard x:Uid="BrandEditDialog_StyleSettingsCard">
                        <ComboBox
                            MinWidth="200"
                            ItemsSource="{x:Bind ViewModel.AllFramePresets, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedFramePresetIndex, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:QrFramePresetOption">
                                    <TextBlock Text="{x:Bind Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </settingsControls:SettingsCard>
                    <settingsControls:SettingsCard
                        Description="{x:Bind ViewModel.FrameTextDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.FrameTextHeader, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsFrameTextVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBox
                            MinWidth="200"
                            PlaceholderText="{x:Bind ViewModel.FrameTextPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.EditFrameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </settingsControls:SettingsCard>
                </settingsControls:SettingsExpander.Items>
            </settingsControls:SettingsExpander>

            <!--  URL / text  -->
            <settingsControls:SettingsExpander x:Uid="BrandEditDialog_URLTextSettingsExpander" IsExpanded="{x:Bind ViewModel.IncludeUrl, Mode=OneWay}">
                <settingsControls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE71B;" />
                </settingsControls:SettingsExpander.HeaderIcon>
                <settingsControls:SettingsExpander.Content>
                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.IncludeUrl, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </settingsControls:SettingsExpander.Content>
                <settingsControls:SettingsExpander.Items>
                    <settingsControls:SettingsCard x:Uid="BrandEditDialog_ContentSettingsCard">
                        <TextBox
                            x:Uid="BrandEditDialog_URLOrTextContentTextBox"
                            MinWidth="250"
                            Text="{x:Bind ViewModel.UrlContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </settingsControls:SettingsCard>
                </settingsControls:SettingsExpander.Items>
            </settingsControls:SettingsExpander>

            <!--  Logo image  -->
            <settingsControls:SettingsExpander x:Uid="BrandEditDialog_LogoImageSettingsExpander" IsExpanded="{x:Bind ViewModel.IncludeLogo, Mode=OneWay}">
                <settingsControls:SettingsExpander.HeaderIcon>
                    <SymbolIcon Symbol="Pictures" />
                </settingsControls:SettingsExpander.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.IncludeLogo, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
                <settingsControls:SettingsExpander.Items>
                    <!--  Image picker  -->
                    <settingsControls:SettingsCard x:Uid="BrandEditDialog_ImageSettingsCard">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <!--  Preview  -->
                            <Grid Width="48" Height="48">
                                <Border
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{x:Bind ViewModel.LogoPath, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverted, Mode=OneWay}">
                                    <Viewbox Width="20" Height="20">
                                        <SymbolIcon Symbol="Pictures" />
                                    </Viewbox>
                                </Border>
                                <Border
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{x:Bind ViewModel.LogoPath, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                                    <Image
                                        MaxWidth="44"
                                        MaxHeight="44"
                                        Source="{x:Bind ViewModel.LogoPath, Converter={StaticResource FilePathToImage}, Mode=OneWay}"
                                        Stretch="Uniform" />
                                </Border>
                            </Grid>
                            <Button Command="{x:Bind ViewModel.SelectLogoCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Pictures" />
                                    <TextBlock x:Uid="BrandEditDialog_PickImageText" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Uid="BrandEditDialog_RemoveLogoButton"
                                Command="{x:Bind ViewModel.ClearLogoCommand}"
                                Visibility="{x:Bind ViewModel.LogoPath, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                                <SymbolIcon Symbol="Cancel" />
                            </Button>
                        </StackPanel>
                    </settingsControls:SettingsCard>
                    <!--  Size slider  -->
                    <settingsControls:SettingsCard x:Uid="BrandEditDialog_ImageSizeSettingsCard" Description="{x:Bind ViewModel.LogoSizeDescription, Mode=OneWay}">
                        <Slider
                            MinWidth="200"
                            Maximum="30"
                            Minimum="7"
                            StepFrequency="1"
                            TickFrequency="5"
                            TickPlacement="BottomRight"
                            Value="{x:Bind ViewModel.LogoSize, Mode=TwoWay}" />
                    </settingsControls:SettingsCard>
                    <!--  Padding slider  -->
                    <settingsControls:SettingsCard x:Uid="BrandEditDialog_PaddingSettingsCard" Description="{x:Bind ViewModel.LogoPaddingDescription, Mode=OneWay}">
                        <Slider
                            MinWidth="200"
                            Maximum="20"
                            Minimum="-20"
                            StepFrequency="1"
                            TickFrequency="8"
                            TickPlacement="BottomRight"
                            Value="{x:Bind ViewModel.LogoPadding, Mode=TwoWay}" />
                    </settingsControls:SettingsCard>
                </settingsControls:SettingsExpander.Items>
            </settingsControls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
