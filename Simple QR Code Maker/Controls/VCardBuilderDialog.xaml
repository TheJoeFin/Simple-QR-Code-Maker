<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Simple_QR_Code_Maker.Controls.VCardBuilderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="VCardBuilderDialog_Dialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="DialogScrollViewer"
        MaxHeight="680"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Border
            Width="{x:Bind DialogScrollViewer.ActualWidth, Mode=OneWay}"
            MinWidth="460"
            Padding="0,0,12,0">
            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                <TextBlock x:Uid="VCardBuilderDialog_StartWithTheCommonContactText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBox
                    x:Name="FormattedNameTextBox"
                    x:Uid="VCardBuilderDialog_FormattedNameTextBox"
                    Text="{x:Bind ViewModel.FormattedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Uid="VCardBuilderDialog_FirstNameTextBox"
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        x:Uid="VCardBuilderDialog_LastNameTextBox"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Uid="VCardBuilderDialog_MiddleTextBox"
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.MiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        x:Uid="VCardBuilderDialog_PrefixTextBox"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        x:Uid="VCardBuilderDialog_SuffixTextBox"
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBox x:Uid="VCardBuilderDialog_OrganizationTextBox" Text="{x:Bind ViewModel.Organization, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox x:Uid="VCardBuilderDialog_TitleTextBox" Text="{x:Bind ViewModel.JobTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox x:Uid="VCardBuilderDialog_MobilePhoneTextBox" Text="{x:Bind ViewModel.MobilePhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox x:Uid="VCardBuilderDialog_EmailTextBox" Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox x:Uid="VCardBuilderDialog_WebsiteTextBox" Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button x:Uid="VCardBuilderDialog_AddAnOptionalVCardFieldButton" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock x:Uid="VCardBuilderDialog_AddFieldText" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem
                                x:Uid="VCardBuilderDialog_WorkPhoneMenuItem"
                                Command="{x:Bind ViewModel.AddOptionalFieldCommand}"
                                CommandParameter="WorkPhone" />
                            <MenuFlyoutItem
                                x:Uid="VCardBuilderDialog_HomePhoneMenuItem"
                                Command="{x:Bind ViewModel.AddOptionalFieldCommand}"
                                CommandParameter="HomePhone" />
                            <MenuFlyoutItem
                                x:Uid="VCardBuilderDialog_NicknameMenuItem"
                                Command="{x:Bind ViewModel.AddOptionalFieldCommand}"
                                CommandParameter="Nickname" />
                            <MenuFlyoutItem
                                x:Uid="VCardBuilderDialog_BirthdayMenuItem"
                                Command="{x:Bind ViewModel.AddOptionalFieldCommand}"
                                CommandParameter="Birthday" />
                            <MenuFlyoutItem
                                x:Uid="VCardBuilderDialog_AddressMenuItem"
                                Command="{x:Bind ViewModel.AddOptionalFieldCommand}"
                                CommandParameter="Address" />
                            <MenuFlyoutItem
                                x:Uid="VCardBuilderDialog_NoteMenuItem"
                                Command="{x:Bind ViewModel.AddOptionalFieldCommand}"
                                CommandParameter="Note" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.WorkPhoneVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="VCardBuilderDialog_WorkPhoneText"
                                Grid.Column="0"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <HyperlinkButton
                                x:Uid="VCardBuilderDialog_RemoveWorkPhoneHyperlinkButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.RemoveOptionalFieldCommand}"
                                CommandParameter="WorkPhone">
                                <SymbolIcon Symbol="Delete" />
                            </HyperlinkButton>
                        </Grid>
                        <TextBox x:Uid="VCardBuilderDialog_15550101TextBox" Text="{x:Bind ViewModel.WorkPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HomePhoneVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="VCardBuilderDialog_HomePhoneText"
                                Grid.Column="0"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <HyperlinkButton
                                x:Uid="VCardBuilderDialog_RemoveHomePhoneHyperlinkButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.RemoveOptionalFieldCommand}"
                                CommandParameter="HomePhone">
                                <SymbolIcon Symbol="Delete" />
                            </HyperlinkButton>
                        </Grid>
                        <TextBox x:Uid="VCardBuilderDialog_15550102TextBox" Text="{x:Bind ViewModel.HomePhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.NicknameVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="VCardBuilderDialog_NicknameText"
                                Grid.Column="0"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <HyperlinkButton
                                x:Uid="VCardBuilderDialog_RemoveNicknameHyperlinkButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.RemoveOptionalFieldCommand}"
                                CommandParameter="Nickname">
                                <SymbolIcon Symbol="Delete" />
                            </HyperlinkButton>
                        </Grid>
                        <TextBox x:Uid="VCardBuilderDialog_JanieTextBox" Text="{x:Bind ViewModel.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.BirthdayVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="VCardBuilderDialog_BirthdayText"
                                Grid.Column="0"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <HyperlinkButton
                                x:Uid="VCardBuilderDialog_RemoveBirthdayHyperlinkButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.RemoveOptionalFieldCommand}"
                                CommandParameter="Birthday">
                                <SymbolIcon Symbol="Delete" />
                            </HyperlinkButton>
                        </Grid>
                        <TextBox x:Uid="VCardBuilderDialog_19901021TextBox" Text="{x:Bind ViewModel.Birthday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.AddressVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="VCardBuilderDialog_AddressText"
                                Grid.Column="0"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <HyperlinkButton
                                x:Uid="VCardBuilderDialog_RemoveAddressHyperlinkButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.RemoveOptionalFieldCommand}"
                                CommandParameter="Address">
                                <SymbolIcon Symbol="Delete" />
                            </HyperlinkButton>
                        </Grid>
                        <TextBox x:Uid="VCardBuilderDialog_StreetTextBox" Text="{x:Bind ViewModel.StreetAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="VCardBuilderDialog_CityTextBox"
                                Grid.Column="0"
                                Text="{x:Bind ViewModel.Locality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Uid="VCardBuilderDialog_StateRegionTextBox"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="VCardBuilderDialog_PostalCodeTextBox"
                                Grid.Column="0"
                                Text="{x:Bind ViewModel.PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Uid="VCardBuilderDialog_CountryTextBox"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.NoteVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="VCardBuilderDialog_NoteText"
                                Grid.Column="0"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <HyperlinkButton
                                x:Uid="VCardBuilderDialog_RemoveNoteHyperlinkButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.RemoveOptionalFieldCommand}"
                                CommandParameter="Note">
                                <SymbolIcon Symbol="Delete" />
                            </HyperlinkButton>
                        </Grid>
                        <TextBox
                            x:Uid="VCardBuilderDialog_AddContactNotesTextBox"
                            MinHeight="72"
                            AcceptsReturn="True"
                            Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBox
                    x:Uid="VCardBuilderDialog_PreviewTextBox"
                    MinHeight="128"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.PreviewVCard, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</ContentDialog>
