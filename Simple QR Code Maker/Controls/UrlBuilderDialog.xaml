<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Simple_QR_Code_Maker.Controls.UrlBuilderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    x:Name="Root"
    x:Uid="UrlBuilderDialog_Root"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="DialogScrollViewer"
        MaxHeight="640"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Border
            Width="{x:Bind DialogScrollViewer.ActualWidth, Mode=OneWay}"
            MinWidth="420"
            Padding="0,0,12,0">
            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.LineNavigationVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Uid="UrlBuilderDialog_GoToThePreviousLineButton"
                        Grid.Column="0"
                        Command="{x:Bind ViewModel.GoToPreviousLineCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock x:Uid="UrlBuilderDialog_PreviousText" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.CurrentLineLabel, Mode=OneWay}" />
                    <Button
                        x:Uid="UrlBuilderDialog_GoToTheNextLineButton"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.GoToNextLineCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="UrlBuilderDialog_NextText" />
                            <SymbolIcon Symbol="Forward" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBox
                    x:Name="SchemeTextBox"
                    x:Uid="UrlBuilderDialog_SchemeTextBox"
                    Text="{x:Bind ViewModel.Scheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    x:Name="AuthorityTextBox"
                    x:Uid="UrlBuilderDialog_AuthorityTextBox"
                    Text="{x:Bind ViewModel.Authority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox x:Uid="UrlBuilderDialog_PathTextBox" Text="{x:Bind ViewModel.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="UrlBuilderDialog_QueryParametersText"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <Button
                        x:Uid="UrlBuilderDialog_AddAQueryParameterButton"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.AddQueryParameterCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock x:Uid="UrlBuilderDialog_AddParameterText" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        x:Uid="UrlBuilderDialog_NoQueryParametersYetText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.EmptyQueryParametersVisibility, Mode=OneWay}" />

                    <ItemsControl HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.QueryParameters, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:UrlBuilderQueryParameter">
                                <Grid
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Uid="UrlBuilderDialog_NameTextBox"
                                        Grid.Column="0"
                                        Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Uid="UrlBuilderDialog_ValueTextBox"
                                        Grid.Column="1"
                                        Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <HyperlinkButton
                                        x:Uid="UrlBuilderDialog_RemoveParameterHyperlinkButton"
                                        Grid.Column="2"
                                        Margin="0,22,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Click="RemoveQueryParameterButton_Click">
                                        <SymbolIcon Symbol="Delete" />
                                    </HyperlinkButton>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBox x:Uid="UrlBuilderDialog_FragmentTextBox" Text="{x:Bind ViewModel.Fragment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    x:Uid="UrlBuilderDialog_PreviewTextBox"
                    MinHeight="72"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.PreviewUrl, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</ContentDialog>
