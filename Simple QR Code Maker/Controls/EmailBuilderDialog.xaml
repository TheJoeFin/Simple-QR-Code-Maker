<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Simple_QR_Code_Maker.Controls.EmailBuilderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="EmailBuilderDialog_Dialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="DialogScrollViewer"
        MaxHeight="640"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Border
            Width="{x:Bind DialogScrollViewer.ActualWidth, Mode=OneWay}"
            MinWidth="420"
            Padding="0,0,12,0">
            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                <TextBlock x:Uid="EmailBuilderDialog_CreateAQRCodeThatText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBox
                    x:Name="ToTextBox"
                    x:Uid="EmailBuilderDialog_ToTextBox"
                    InputScope="EmailSmtpAddress"
                    Text="{x:Bind ViewModel.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    x:Uid="EmailBuilderDialog_CCTextBox"
                    InputScope="EmailSmtpAddress"
                    Text="{x:Bind ViewModel.Cc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    x:Uid="EmailBuilderDialog_BCCTextBox"
                    InputScope="EmailSmtpAddress"
                    Text="{x:Bind ViewModel.Bcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox x:Uid="EmailBuilderDialog_SubjectTextBox" Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    x:Uid="EmailBuilderDialog_BodyTextBox"
                    MinHeight="96"
                    AcceptsReturn="True"
                    Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <InfoBar
                    x:Uid="EmailBuilderDialog_HowItWorksInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <TextBox
                    x:Uid="EmailBuilderDialog_PreviewTextBox"
                    MinHeight="72"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.PreviewEmailUri, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</ContentDialog>
