<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.HistoryRowItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Simple_QR_Code_Maker.Helpers"
    xmlns:local="using:Simple_QR_Code_Maker.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsed" />
        <converters:FilePathToImageSourceConverter x:Key="FilePathToImage" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="2" Padding="0,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TextBlock
            MaxLines="24"
            Style="{StaticResource BodyTextStyle}"
            Text="{x:Bind helpers:LocalizedDisplay.HistoryText(Data), Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="16" />
                        <Setter Property="Height" Value="10" />
                    </Style>
                </StackPanel.Resources>
                <Rectangle Fill="{x:Bind DisplayForeground(Data.Foreground, Data.SingleCodeCommonBrand), Mode=OneWay}" />
                <Rectangle Fill="{x:Bind DisplayBackground(Data.Background, Data.SingleCodeCommonBrand), Mode=OneWay}" />
                <TextBlock Text="{x:Bind DisplayErrorCorrection(Data.ErrorCorrectionLevelAsString, Data.SingleCodeCommonBrand), Mode=OneWay}" />
                <TextBlock Text="{x:Bind helpers:LocalizedDisplay.ContentKindName(Data.ContentKind), Mode=OneWay}" Visibility="{x:Bind Data.ContentKindLabel, Converter={StaticResource EmptyStringToCollapsed}, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Data.CommonBrandLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind Data.CommonBrandLabel, Mode=OneWay}"
                Visibility="{x:Bind Data.CommonBrandLabel, Converter={StaticResource EmptyStringToCollapsed}, Mode=OneWay}" />
        </Grid>
        <TextBlock
            Grid.Row="2"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind Data.SaveDateAsString, Mode=OneWay}"
            TextTrimming="WordEllipsis" />
        <Image
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="32"
            Height="32"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            Source="{x:Bind Data.DisplayLogoPath, Converter={StaticResource FilePathToImage}, Mode=OneWay}"
            Stretch="Uniform"
            Visibility="{x:Bind Data.DisplayLogoPath, Converter={StaticResource NullToVisibility}, Mode=OneWay}" />
    </Grid>
</UserControl>

