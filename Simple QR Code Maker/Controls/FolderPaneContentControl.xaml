<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.FolderPaneContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </UserControl.Resources>

    <Grid
        Padding="16,12"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: folder name + close button  -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel MaxWidth="200" VerticalAlignment="Center">
                <TextBlock
                    x:Uid="FolderPaneContentControl_FolderText"
                    MaxLines="1"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.FolderPaneFolderName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button
                x:Uid="FolderPaneContentControl_CloseFolderPaneButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.CloseFolderPaneCommand, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <SymbolIcon Symbol="Cancel" />
            </Button>
        </Grid>

        <!--  Empty state  -->
        <TextBlock
            x:Uid="FolderPaneContentControl_NoImageFilesFoundInText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.FolderFiles.Count, Converter={StaticResource EmptyCollectionToVisibility}, Mode=OneWay}" />

        <!--  File list  -->
        <ListView
            x:Name="FolderFilesListView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.FolderFiles, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.FolderFiles.Count, Converter={StaticResource EmptyCollectionToVisibility}, ConverterParameter=true, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FolderFileItem">
                    <StackPanel>
                        <!--  File row  -->
                        <Grid
                            Margin="0,4"
                            ColumnSpacing="8"
                            Tag="{x:Bind}"
                            Tapped="FolderFileItem_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Thumbnail  -->
                            <Border
                                Width="56"
                                Height="56"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                            </Border>

                            <!--  File name  -->
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{x:Bind FileName}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!--  Cut-outs (indented below parent)  -->
                        <ItemsControl Margin="12,0,0,4" ItemsSource="{x:Bind CutOuts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DecodingImageItem">
                                    <Grid
                                        Margin="0,2"
                                        ColumnSpacing="8"
                                        PointerEntered="CutOutItem_PointerEntered"
                                        PointerExited="CutOutItem_PointerExited"
                                        Tag="{x:Bind}"
                                        Tapped="CutOutItem_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <Image Source="{x:Bind BitmapImage, Mode=OneWay}" Stretch="Uniform" />
                                        </Border>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Margin="0,0,32,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                Text="{x:Bind Label, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <Button
                                                x:Uid="FolderPaneContentControl_SaveCutOutImageButton"
                                                Padding="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="SaveCutOutButton_Click"
                                                Opacity="0"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Tag="{x:Bind}"
                                                Tapped="SaveCutOutButton_Tapped">
                                                <FontIcon FontSize="12" Glyph="&#xE74E;" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Footer buttons  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,0"
            Spacing="8">
            <Button
                x:Uid="FolderPaneContentControl_DecodeAllImagesAndViewButton"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.ShowFolderSummaryCommand, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.ShowFolderSummaryCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="List" />
                    <TextBlock x:Uid="FolderPaneContentControl_SummaryViewText" />
                </StackPanel>
            </Button>
            <Button
                x:Uid="FolderPaneContentControl_DecodeEveryImageInTheButton"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.DecodeAllAndExportCommand, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.DecodeAllAndExportCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Download" />
                    <TextBlock x:Uid="FolderPaneContentControl_DecodeAllExportTxtFilesText" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
