<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Simple_QR_Code_Maker.Controls.QrDesignDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Simple_QR_Code_Maker.Controls"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    Title="QR code design"
    CloseButtonText="Done"
    DefaultButton="None"
    Opened="DesignDialog_Opened"
    Closed="DesignDialog_Closed">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="DesignTileTemplate" x:DataType="controls:QrDesignGalleryItem">
            <StackPanel Width="104" Spacing="6" ToolTipService.ToolTip="{x:Bind Description}">
                <Image Width="104" Height="112" Source="{x:Bind Thumbnail}" Stretch="Uniform" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Name}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="DesignTileStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <Grid x:Name="DialogLayout" Width="760" Height="620" ColumnSpacing="24" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PreviewColumn" Width="240" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="PreviewPane" Grid.Column="1" Grid.RowSpan="2" Spacing="12">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Live preview" />
            <Border Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                <Image x:Name="LivePreviewImage" MaxHeight="500" Stretch="Uniform" AutomationProperties.Name="Current QR code design preview" />
            </Border>
            <TextBlock x:Name="NoPreviewText" Text="Enter QR content in the main window to see a live preview here."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PreviewHelpText" Style="{StaticResource CaptionTextBlockStyle}" Text="Changes apply immediately. Choose Done to return to your QR codes."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ScrollViewer x:Name="DesignScroller" Grid.RowSpan="2" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DesignPanel" Spacing="12">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Pick a look, then make it your own. Your QR content stays the same."
                           TextWrapping="Wrap" />
                <SelectorBar x:Name="DesignSections" AutomationProperties.AutomationId="DesignSections" SelectionChanged="DesignSections_SelectionChanged">
                    <SelectorBarItem x:Name="PresetsSection" IsSelected="True" Text="Presets" />
                    <SelectorBarItem x:Name="PatternSection" Text="Pattern" />
                    <SelectorBarItem x:Name="FrameSection" Text="Frame" />
                </SelectorBar>
                <ProgressRing x:Name="PreviewProgress" Width="28" Height="28" IsActive="False" Visibility="Collapsed" />
                <InfoBar x:Name="PreviewError" IsClosable="True" Severity="Error" Title="Design previews unavailable" />
                <!-- This outer ScrollViewer owns scrolling; the small galleries do not scroll independently. -->
                <GridView x:Name="PresetGrid"
                          ItemsSource="{x:Bind Presets}"
                          ItemTemplate="{StaticResource DesignTileTemplate}"
                          ItemContainerStyle="{StaticResource DesignTileStyle}"
                          ContainerContentChanging="Gallery_ContainerContentChanging"
                          SelectionChanged="PresetGrid_SelectionChanged"
                          SelectionMode="Single"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          AutomationProperties.AutomationId="DesignPresetGallery"
                          AutomationProperties.Name="Coordinated design presets">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
                <StackPanel x:Name="PatternPanel" Spacing="12" Visibility="Collapsed">
                    <ComboBox x:Name="ModuleCombo" AutomationProperties.AutomationId="QrModuleStyle" Header="QR pattern" HorizontalAlignment="Stretch" SelectionChanged="ModuleCombo_SelectionChanged" />
                    <ComboBox x:Name="EyeCombo" AutomationProperties.AutomationId="QrEyeStyle" Header="Corner eyes" HorizontalAlignment="Stretch" SelectionChanged="EyeCombo_SelectionChanged" />
                    <TextBlock Text="The small timing and alignment patterns stay square to help scanners read your code."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button AutomationProperties.AutomationId="ResetQrPattern" Content="Classic squares" Click="ClassicPattern_Click" />
                    <DropDownButton AutomationProperties.AutomationId="DesignForegroundPickerButton" Content="QR color and opacity" HorizontalAlignment="Stretch">
                        <DropDownButton.Flyout>
                            <Flyout>
                                <ColorPicker AutomationProperties.AutomationId="DesignForegroundPicker"
                                             Color="{x:Bind ViewModel.ForegroundColor, Mode=TwoWay}" IsAlphaEnabled="True"
                                             IsColorChannelTextInputVisible="True" AutomationProperties.Name="QR color and opacity" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton AutomationProperties.AutomationId="DesignBackgroundPickerButton" Content="Background color and opacity" HorizontalAlignment="Stretch">
                        <DropDownButton.Flyout>
                            <Flyout>
                                <ColorPicker AutomationProperties.AutomationId="DesignBackgroundPicker"
                                             Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}" IsAlphaEnabled="True"
                                             IsColorChannelTextInputVisible="True" AutomationProperties.Name="QR background color and opacity" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Transparent backgrounds depend on the surface where you place the QR code."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="FramePanel" Spacing="12" Visibility="Collapsed">
                    <GridView x:Name="FrameGrid"
                              ItemsSource="{x:Bind Frames}"
                              ItemTemplate="{StaticResource DesignTileTemplate}"
                              ItemContainerStyle="{StaticResource DesignTileStyle}"
                              ContainerContentChanging="Gallery_ContainerContentChanging"
                              SelectionChanged="FrameGrid_SelectionChanged"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              AutomationProperties.AutomationId="FrameShapeGallery"
                              AutomationProperties.Name="Frame shapes">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsFrameTextVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBox AutomationProperties.AutomationId="FrameCaption" Header="{x:Bind ViewModel.FrameTextHeader, Mode=OneWay}"
                                 PlaceholderText="{x:Bind ViewModel.FrameTextPlaceholder, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.FrameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox x:Name="CaptionSuggestionCombo" AutomationProperties.AutomationId="CaptionIdeas" Header="Caption ideas" HorizontalAlignment="Stretch"
                                  SelectionChanged="CaptionSuggestionCombo_SelectionChanged" />
                        <ComboBox x:Name="LabelSourceCombo" AutomationProperties.AutomationId="CaptionSource" Header="Label source" HorizontalAlignment="Stretch" SelectionChanged="LabelSourceCombo_SelectionChanged" />
                        <TextBlock Text="{x:Bind ViewModel.FrameTextHelperText, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.IsFrameFallbackInfoVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox x:Name="IconCombo" AutomationProperties.AutomationId="CaptionIcon" Header="Caption icon" HorizontalAlignment="Stretch" SelectionChanged="IconCombo_SelectionChanged" />
                        <ToggleSwitch AutomationProperties.AutomationId="CustomFrameAccent" Header="Independent frame color" IsOn="{x:Bind ViewModel.UseCustomFrameAccent, Mode=TwoWay}"
                                      OffContent="Use QR code color" OnContent="Custom accent" />
                        <DropDownButton AutomationProperties.AutomationId="FrameAccentPickerButton" Content="Accent color" IsEnabled="{x:Bind ViewModel.UseCustomFrameAccent, Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker AutomationProperties.AutomationId="FrameAccentPicker" Color="{x:Bind ViewModel.FrameAccentColor, Mode=TwoWay}" IsAlphaEnabled="False"
                                                 IsColorChannelTextInputVisible="True" AutomationProperties.Name="Frame accent color" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <ToggleSwitch AutomationProperties.AutomationId="FrameGradient" Header="Frame gradient" IsOn="{x:Bind ViewModel.UseFrameGradient, Mode=TwoWay}"
                                      OffContent="Solid color" OnContent="Two-color gradient" />
                        <DropDownButton AutomationProperties.AutomationId="FrameGradientPickerButton" Content="Gradient end color" IsEnabled="{x:Bind ViewModel.UseFrameGradient, Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker AutomationProperties.AutomationId="FrameGradientEndPicker" Color="{x:Bind ViewModel.FrameGradientEndColor, Mode=TwoWay}" IsAlphaEnabled="False"
                                                 IsColorChannelTextInputVisible="True" AutomationProperties.Name="Frame gradient end color" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Presets use a clear four-module margin. Keep the code dark on a light background, and try the final size with your phone before printing."
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Spacing="8">
                    <Button AutomationProperties.AutomationId="UndoDesignPreset" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.UndoDesignPresetCommand}" Content="Undo preset" />
                    <Button AutomationProperties.AutomationId="SaveDefaultDesign" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SetFrameAsDefaultCommand}" Content="Set design as default" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
