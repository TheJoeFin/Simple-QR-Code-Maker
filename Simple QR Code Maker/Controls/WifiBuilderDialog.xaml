<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Simple_QR_Code_Maker.Controls.WifiBuilderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="WifiBuilderDialog_Dialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="DialogScrollViewer"
        MaxHeight="640"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Border
            Width="{x:Bind DialogScrollViewer.ActualWidth, Mode=OneWay}"
            MinWidth="420"
            Padding="0,0,12,0">
            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                <TextBlock x:Uid="WifiBuilderDialog_CreateAQRCodeThatText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBox
                    x:Name="SsidTextBox"
                    x:Uid="WifiBuilderDialog_SsidTextBox"
                    Text="{x:Bind ViewModel.Ssid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox x:Uid="WifiBuilderDialog_SecurityTypeComboBox" SelectedIndex="{x:Bind ViewModel.SelectedAuthenticationTypeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="WifiBuilderDialog_WPAWPA2WPA3ComboBoxItem" Tag="WPA" />
                    <ComboBoxItem x:Uid="WifiBuilderDialog_WEPLegacyComboBoxItem" Tag="WEP" />
                    <ComboBoxItem x:Uid="WifiBuilderDialog_NoneOpenNetworkComboBoxItem" Tag="None" />
                </ComboBox>

                <TextBox
                    x:Uid="WifiBuilderDialog_PasswordTextBox"
                    Text="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.PasswordVisibility, Mode=OneWay}" />

                <CheckBox x:Uid="WifiBuilderDialog_ThisIsAHiddenNetworkCheckBox" IsChecked="{x:Bind ViewModel.IsHiddenNetwork, Mode=TwoWay}" />

                <InfoBar
                    x:Uid="WifiBuilderDialog_OpenNetworkInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.OpenNetworkInfoVisibility, Mode=OneWay}" />

                <InfoBar
                    x:Uid="WifiBuilderDialog_LegacySecurityInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.LegacySecurityWarningVisibility, Mode=OneWay}" />

                <InfoBar
                    x:Uid="WifiBuilderDialog_BeforeYouShareThisInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning"
                    Visibility="Visible" />

                <TextBox
                    x:Uid="WifiBuilderDialog_PreviewTextBox"
                    MinHeight="72"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.PreviewWifiPayload, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</ContentDialog>
