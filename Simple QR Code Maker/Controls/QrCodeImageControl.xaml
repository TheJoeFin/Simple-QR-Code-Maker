<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.QrCodeImageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Simple_QR_Code_Maker.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Margin="4"
        HorizontalAlignment="Center"
        VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image
            x:Name="QrCodeImage"
            Width="300"
            Height="300"
            AutomationProperties.AutomationId="QrCodePreview"
            CanDrag="True"
            DragStarting="QrCodeImage_DragStarting"
            Source="{x:Bind Data.CodeAsBitmap,
                            Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Data.ToolTipText,
                                            Mode=OneWay}">
            <Image.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Command="{x:Bind Data.SaveCodePngContextCommand,
                                         Mode=OneWay}"
                        Icon="Save"
                        Text="Save PNG..." />
                    <MenuFlyoutItem
                        Command="{x:Bind Data.CopyCodePngContextCommand,
                                         Mode=OneWay}"
                        Icon="Copy"
                        Text="Copy PNG" />
                    <MenuFlyoutItem
                        Command="{x:Bind Data.ShareCodeContextCommand,
                                         Mode=OneWay}"
                        Icon="Share"
                        Text="Share..." />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Command="{x:Bind Data.SaveCodeSvgContextCommand,
                                         Mode=OneWay}"
                        Icon="Save"
                        Text="Save SVG..." />
                    <MenuFlyoutItem
                        Command="{x:Bind Data.CopyCodeSvgContextCommand,
                                         Mode=OneWay}"
                        Icon="Copy"
                        Text="Copy SVG" />
                    <MenuFlyoutItem
                        Command="{x:Bind Data.CopyCodeSvgTextContextCommand,
                                         Mode=OneWay}"
                        Icon="Copy"
                        Text="Copy SVG as Text" />
                    <MenuFlyoutSeparator Visibility="{x:Bind BoolToVisibility(Data.CanApplyCommonBrand), Mode=OneWay}" />
                    <MenuFlyoutItem
                        Command="{x:Bind Data.UseCommonBrandContextCommand, Mode=OneWay}"
                        Text="Use common brand"
                        ToolTipService.ToolTip="{x:Bind Data.CommonBrandToolTip, Mode=OneWay}"
                        Visibility="{x:Bind BoolToVisibility(Data.CanApplyCommonBrand), Mode=OneWay}" />
                    <MenuFlyoutSeparator Visibility="{x:Bind BoolToVisibility(Data.CanUseCurrentStyle), Mode=OneWay}" />
                    <MenuFlyoutItem
                        Command="{x:Bind Data.IgnoreAutoBrandContextCommand,
                                         Mode=OneWay}"
                        Text="Use current style"
                        Visibility="{x:Bind BoolToVisibility(Data.CanUseCurrentStyle), Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8D7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Image.ContextFlyout>
        </Image>
        <InfoBar
            IsOpen="{x:Bind Data.UrlWarning,
                            Mode=OneWay}"
            Message="QR Code not a URL"
            Severity="Warning"
            ToolTipService.ToolTip="This warning can be disabled in settings" />
        <Border
            Grid.Row="1"
            Width="300"
            Padding="{x:Bind SizeBarPadding(Data.CanRecommendCommonBrand), Mode=OneWay}"
            AutomationProperties.AutomationId="QrSizeBar"
            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
            CornerRadius="6"
            Visibility="{x:Bind SizeTextVisibility(Data.IsCommonBranded, Data.SizeTextVisible), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton
                    MinWidth="0"
                    Padding="0,2,8,0"
                    VerticalAlignment="Top"
                    Command="{x:Bind Data.FaqButtonCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="How was this calculated?">
                    <local:RulerIcon />
                </HyperlinkButton>
                <Grid
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Data.SizeRecommendationTitle, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Data.SizeRecommendationText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </Grid>
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Command="{x:Bind Data.CopySizeTextCommand, Mode=OneWay}"
                        Icon="Copy"
                        IsEnabled="{x:Bind Data.CanCopySizeText, Mode=OneWay}"
                        Text="Copy Size" />
                    <MenuFlyoutItem Command="{x:Bind Data.HideSizeTextCommand, Mode=OneWay}" Text="Hide min. size text">
                        <MenuFlyoutItem.Icon>
                            <local:HideIcon />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
        </Border>
        <Button
            Grid.Row="1"
            Width="{x:Bind CommonBrandActionWidth(Data.IsCommonBranded), Mode=OneWay}"
            Height="32"
            Padding="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="CommonBrandAction"
            AutomationProperties.HelpText="{x:Bind Data.CommonBrandToolTip, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Data.CommonBrandActionName, Mode=OneWay}"
            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Command="{x:Bind Data.UseCommonBrandContextCommand, Mode=OneWay}"
            Visibility="{x:Bind BoolToVisibility(Data.ShowCommonBrandAction), Mode=OneWay}">
            <ToolTipService.ToolTip>
                <ToolTip
                    MaxWidth="320"
                    AutomationProperties.AutomationId="CommonBrandToolTip"
                    Placement="Bottom">
                    <StackPanel Width="264" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="40" Height="40" AutomationProperties.AccessibilityView="Raw">
                                <Image.Source>
                                    <SvgImageSource UriSource="{x:Bind Data.CommonBrandLogoUri, Mode=OneWay}" />
                                </Image.Source>
                            </Image>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Data.CommonBrandName, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Data.CommonBrandToolTip, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Your current design is kept, so you can switch back anytime."
                            TextWrapping="Wrap" />
                        <StackPanel Spacing="4" Visibility="{x:Bind Data.SizeTextVisible, Mode=OneWay}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Data.SizeRecommendationTitle, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Data.SizeRecommendationText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Minimum-size estimates are unavailable with a center logo."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
            <Button.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Command="{x:Bind Data.CopySizeTextCommand, Mode=OneWay}"
                        Icon="Copy"
                        IsEnabled="{x:Bind Data.CanCopySizeText, Mode=OneWay}"
                        Text="Copy Size"
                        Visibility="{x:Bind Data.SizeTextVisible, Mode=OneWay}" />
                    <MenuFlyoutItem Command="{x:Bind Data.FaqButtonCommand, Mode=OneWay}" Text="About QR Code sizing" />
                </MenuFlyout>
            </Button.ContextFlyout>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="20" Height="20" AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <SvgImageSource UriSource="{x:Bind Data.CommonBrandLogoUri, Mode=OneWay}" />
                    </Image.Source>
                </Image>
                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind Data.CommonBrandName, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(Data.IsCommonBranded), Mode=OneWay}" />
                <Viewbox
                    Grid.Column="2"
                    Width="16"
                    Height="16"
                    Margin="4,0,4,0"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind BoolToVisibility(Data.IsCommonBranded), Mode=OneWay}">
                    <SymbolIcon
                        AutomationProperties.AccessibilityView="Raw"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Undo" />
                </Viewbox>
            </Grid>
        </Button>
    </Grid>
</UserControl>
