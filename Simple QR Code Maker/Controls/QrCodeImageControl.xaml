<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.QrCodeImageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Simple_QR_Code_Maker.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Margin="4"
        HorizontalAlignment="Center"
        VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image
            x:Name="QrCodeImage"
            Width="300"
            Height="300"
            AutomationProperties.AutomationId="QrCodePreview"
            CanDrag="True"
            DragStarting="QrCodeImage_DragStarting"
            Source="{x:Bind Data.CodeAsBitmap, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Data.ToolTipText, Mode=OneWay}">
            <Image.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_SavePNGMenuItem"
                        Command="{x:Bind Data.SaveCodePngContextCommand, Mode=OneWay}"
                        Icon="Save" />
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_CopyPNGMenuItem"
                        Command="{x:Bind Data.CopyCodePngContextCommand, Mode=OneWay}"
                        Icon="Copy" />
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_ShareMenuItem"
                        Command="{x:Bind Data.ShareCodeContextCommand, Mode=OneWay}"
                        Icon="Share" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_SaveSVGMenuItem"
                        Command="{x:Bind Data.SaveCodeSvgContextCommand, Mode=OneWay}"
                        Icon="Save" />
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_CopySVGMenuItem"
                        Command="{x:Bind Data.CopyCodeSvgContextCommand, Mode=OneWay}"
                        Icon="Copy" />
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_CopySVGAsTextMenuItem"
                        Command="{x:Bind Data.CopyCodeSvgTextContextCommand, Mode=OneWay}"
                        Icon="Copy" />
                    <MenuFlyoutSeparator Visibility="{x:Bind BoolToVisibility(Data.CanApplyCommonBrand), Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_UseCommonBrandMenuItem"
                        Command="{x:Bind Data.UseCommonBrandContextCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Data.CommonBrandToolTip, Mode=OneWay}"
                        Visibility="{x:Bind BoolToVisibility(Data.CanApplyCommonBrand), Mode=OneWay}" />
                    <MenuFlyoutSeparator Visibility="{x:Bind BoolToVisibility(Data.CanUseCurrentStyle), Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_UseCurrentStyleMenuItem"
                        Command="{x:Bind Data.IgnoreAutoBrandContextCommand, Mode=OneWay}"
                        Visibility="{x:Bind BoolToVisibility(Data.CanUseCurrentStyle), Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8D7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Image.ContextFlyout>
        </Image>
        <InfoBar
            x:Uid="QrCodeImageControl_ThisWarningCanBeDisabledInfoBar"
            IsOpen="{x:Bind Data.UrlWarning, Mode=OneWay}"
            Severity="Warning" />
        <Border
            Grid.Row="1"
            Width="300"
            Padding="{x:Bind SizeBarPadding(Data.CanRecommendCommonBrand), Mode=OneWay}"
            AutomationProperties.AutomationId="QrSizeBar"
            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
            CornerRadius="6"
            Visibility="{x:Bind SizeTextVisibility(Data.IsCommonBranded, Data.SizeTextVisible), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton
                    x:Uid="QrCodeImageControl_HowWasThisCalculatedHyperlinkButton"
                    MinWidth="0"
                    Padding="0,2,8,0"
                    VerticalAlignment="Top"
                    Command="{x:Bind Data.FaqButtonCommand, Mode=OneWay}">
                    <local:RulerIcon />
                </HyperlinkButton>
                <Grid
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Data.SizeRecommendationTitle, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Data.SizeRecommendationText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </Grid>
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_CopySizeMenuItem"
                        Command="{x:Bind Data.CopySizeTextCommand, Mode=OneWay}"
                        Icon="Copy"
                        IsEnabled="{x:Bind Data.CanCopySizeText, Mode=OneWay}" />
                    <MenuFlyoutItem x:Uid="QrCodeImageControl_HideMinSizeTextMenuItem" Command="{x:Bind Data.HideSizeTextCommand, Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <local:HideIcon />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
        </Border>
        <Button
            Grid.Row="1"
            Width="{x:Bind CommonBrandActionWidth(Data.IsCommonBranded), Mode=OneWay}"
            Height="32"
            Padding="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="CommonBrandAction"
            AutomationProperties.HelpText="{x:Bind Data.CommonBrandToolTip, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Data.CommonBrandActionName, Mode=OneWay}"
            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Command="{x:Bind Data.UseCommonBrandContextCommand, Mode=OneWay}"
            Visibility="{x:Bind BoolToVisibility(Data.ShowCommonBrandAction), Mode=OneWay}">
            <ToolTipService.ToolTip>
                <ToolTip
                    MaxWidth="320"
                    AutomationProperties.AutomationId="CommonBrandToolTip"
                    Placement="Bottom">
                    <StackPanel Width="264" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="40"
                                Height="40"
                                AutomationProperties.AccessibilityView="Raw">
                                <Image.Source>
                                    <SvgImageSource UriSource="{x:Bind Data.CommonBrandLogoUri, Mode=OneWay}" />
                                </Image.Source>
                            </Image>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Data.CommonBrandName, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Data.CommonBrandToolTip, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock
                            x:Uid="QrCodeImageControl_YourCurrentDesignIsKeptText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Spacing="4" Visibility="{x:Bind Data.SizeTextVisible, Mode=OneWay}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Data.SizeRecommendationTitle, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Data.SizeRecommendationText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="QrCodeImageControl_MinimumSizeEstimatesAreUnavailableText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
            <Button.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Uid="QrCodeImageControl_CopySizeMenuItem2"
                        Command="{x:Bind Data.CopySizeTextCommand, Mode=OneWay}"
                        Icon="Copy"
                        IsEnabled="{x:Bind Data.CanCopySizeText, Mode=OneWay}"
                        Visibility="{x:Bind Data.SizeTextVisible, Mode=OneWay}" />
                    <MenuFlyoutItem x:Uid="QrCodeImageControl_AboutQRCodeSizingMenuItem" Command="{x:Bind Data.FaqButtonCommand, Mode=OneWay}" />
                </MenuFlyout>
            </Button.ContextFlyout>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="20"
                    Height="20"
                    AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <SvgImageSource UriSource="{x:Bind Data.CommonBrandLogoUri, Mode=OneWay}" />
                    </Image.Source>
                </Image>
                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind Data.CommonBrandName, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(Data.IsCommonBranded), Mode=OneWay}" />
                <Viewbox
                    Grid.Column="2"
                    Width="16"
                    Height="16"
                    Margin="4,0,4,0"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind BoolToVisibility(Data.IsCommonBranded), Mode=OneWay}">
                    <SymbolIcon
                        AutomationProperties.AccessibilityView="Raw"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Undo" />
                </Viewbox>
            </Grid>
        </Button>
    </Grid>
</UserControl>
