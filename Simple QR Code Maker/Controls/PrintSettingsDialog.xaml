<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Simple_QR_Code_Maker.Controls.PrintSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="PrintSettingsDialog_Dialog"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Style x:Key="PreviewPageBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </ContentDialog.Resources>

    <Grid
        x:Name="DialogLayoutGrid"
        Width="1100"
        Height="680"
        ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="360" />
            <ColumnDefinition x:Name="PreviewColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SettingsRow" Height="*" />
            <RowDefinition x:Name="PreviewRow" Height="0" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="SettingsScrollViewer"
            x:Uid="PrintSettingsDialog_SettingsScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Padding="16" Spacing="12">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ComboBox
                            x:Name="QuickPresetCombo"
                            x:Uid="PrintSettingsDialog_QuickPresetCombo"
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="QuickPresetCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="PrintSettingsDialog_CustomComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_ProductLabelsComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_FlyersOrHandoutsComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_TableTentsOrMenusComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_PostersOrSignsComboBoxItem" />
                        </ComboBox>

                        <TextBlock
                            x:Name="QuickPresetDescriptionTextBlock"
                            x:Uid="PrintSettingsDialog_QuickPresetDescriptionTextBlock"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />

                        <ComboBox
                            x:Name="CodesPerPageCombo"
                            x:Uid="PrintSettingsDialog_CodesPerPageCombo"
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="CodesPerPageCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="PrintSettingsDialog_AsManyFitComboBoxItem" Tag="fit" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_1PerPageComboBoxItem" Tag="1" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_2PerPageComboBoxItem" Tag="2" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_4PerPageComboBoxItem" Tag="4" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_6PerPageComboBoxItem" Tag="6" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_9PerPageComboBoxItem" Tag="9" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_12PerPageComboBoxItem" Tag="12" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_16PerPageComboBoxItem" Tag="16" />
                        </ComboBox>

                        <ComboBox
                            x:Name="PageTypeCombo"
                            x:Uid="PrintSettingsDialog_PageTypeCombo"
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="PageTypeCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="PrintSettingsDialog_LetterComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_LegalComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_StatementComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_ExecutiveComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_TabloidComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_LedgerComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_A3ComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_A4ComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_A5ComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_B4ComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_B5ComboBoxItem" />
                        </ComboBox>

                        <ComboBox
                            x:Name="PageLayoutCombo"
                            x:Uid="PrintSettingsDialog_PageLayoutCombo"
                            Grid.Row="3"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="PageLayoutCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="PrintSettingsDialog_PortraitComboBoxItem" />
                            <ComboBoxItem x:Uid="PrintSettingsDialog_LandscapeComboBoxItem" />
                        </ComboBox>

                        <ToggleSwitch
                            x:Name="ShowLabelsSwitch"
                            x:Uid="PrintSettingsDialog_ShowLabelsSwitch"
                            Grid.Row="3"
                            Grid.Column="1"
                            Toggled="ShowLabelsSwitch_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <NumberBox
                            x:Name="CodeSizeMmBox"
                            x:Uid="PrintSettingsDialog_CodeSizeMmBox"
                            Grid.Row="0"
                            Grid.Column="0"
                            Maximum="250"
                            Minimum="5"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="CodeSizeMmBox_ValueChanged" />

                        <NumberBox
                            x:Name="SpacingMmBox"
                            x:Uid="PrintSettingsDialog_SpacingMmBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Maximum="25"
                            Minimum="0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="SpacingMmBox_ValueChanged" />

                        <NumberBox
                            x:Name="MarginMmBox"
                            x:Uid="PrintSettingsDialog_MarginMmBox"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Maximum="50"
                            Minimum="0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="MarginMmBox_ValueChanged" />
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid
            x:Name="PreviewPane"
            Grid.Column="1"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Uid="PrintSettingsDialog_PreviewText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel
                    x:Name="PreviewZoomControls"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="FitPreviewButton"
                        x:Uid="PrintSettingsDialog_FitPreviewButton"
                        Click="FitPreviewButton_Click" />
                    <Button
                        x:Name="ZoomOutButton"
                        x:Uid="PrintSettingsDialog_ZoomOutButton"
                        Click="ZoomOutButton_Click"
                        Content="-" />
                    <TextBlock
                        x:Name="PreviewZoomTextBlock"
                        x:Uid="PrintSettingsDialog_InitialZoom"
                        MinWidth="56"
                        VerticalAlignment="Center"
                        HorizontalTextAlignment="Center" />
                    <Button
                        x:Name="ZoomInButton"
                        x:Uid="PrintSettingsDialog_ZoomInButton"
                        Click="ZoomInButton_Click"
                        Content="+" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer
                    x:Name="PreviewScrollViewer"
                    x:Uid="PrintSettingsDialog_PreviewScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    MaxZoomFactor="4"
                    MinZoomFactor="0.25"
                    SizeChanged="PreviewScrollViewer_SizeChanged"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled"
                    ViewChanged="PreviewScrollViewer_ViewChanged"
                    ZoomMode="Enabled">
                    <StackPanel
                        x:Name="PreviewPagesPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Spacing="16" />
                </ScrollViewer>
            </Border>

            <StackPanel
                x:Name="PreviewLoadingPanel"
                Grid.Row="1"
                MaxWidth="360"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Spacing="12">
                <ProgressRing IsActive="True" />
                <TextBlock
                    x:Uid="PrintSettingsDialog_UpdatingPDFPreviewText"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <StackPanel
                x:Name="PreviewErrorPanel"
                Grid.Row="1"
                MaxWidth="360"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    Glyph="&#xEA39;" />
                <TextBlock
                    x:Name="PreviewErrorTextBlock"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
