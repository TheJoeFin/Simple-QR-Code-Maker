<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Simple_QR_Code_Maker.Controls.FeedbackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="FeedbackDialog_Dialog"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel MaxWidth="440" Spacing="16">

        <TextBlock x:Uid="FeedbackDialog_HiIMAnIndieText" TextWrapping="Wrap" />

        <TextBox
            x:Name="FeedbackTextBox"
            x:Uid="FeedbackDialog_FeedbackTextBox"
            MinHeight="120"
            AcceptsReturn="True"
            MaxLength="2000"
            TextWrapping="Wrap" />

        <Border
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Glyph="&#xE168;" />
                <TextBlock
                    x:Uid="FeedbackDialog_JoeJoefinappsComText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsTextSelectionEnabled="True" />
                <Button
                    x:Name="CopyEmailButton"
                    x:Uid="FeedbackDialog_CopyEmailButton"
                    Grid.Column="2"
                    Click="CopyEmailButton_Click" />
            </Grid>
        </Border>

        <TextBlock
            x:Uid="FeedbackDialog_OpenMailAppWillOpenText"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

    </StackPanel>
</ContentDialog>
