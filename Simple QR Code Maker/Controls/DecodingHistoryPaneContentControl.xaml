<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.DecodingHistoryPaneContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Simple_QR_Code_Maker.Behaviors"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Simple_QR_Code_Maker.Helpers"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibility" />
        <converters:FilePathToImageSourceConverter x:Key="FilePathToImage" />
    </UserControl.Resources>

    <Grid
        Padding="16,12"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <TextBlock
                x:Uid="DecodingHistoryPaneContentControl_DecodingHistoryText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <HyperlinkButton
                x:Uid="DecodingHistoryPaneContentControl_ClearAllDecodingHistoryHyperlinkButton"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.ClearDecodingHistoryCommand, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.HasDecodingHistory, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock x:Uid="DecodingHistoryPaneContentControl_ClearText" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <TextBlock
            x:Uid="DecodingHistoryPaneContentControl_NoDecodingHistoryYetOpenText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.DecodingHistoryItems.Count, Converter={StaticResource EmptyCollectionToVisibility}, Mode=OneWay}">
            <interactivity:Interaction.Behaviors>
                <behaviors:ImplicitVisibilityAnimationBehavior />
            </interactivity:Interaction.Behaviors>
        </TextBlock>

        <ListView
            x:Name="HistoryListView"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="HistoryListView_ItemClick"
            ItemsSource="{x:Bind ViewModel.DecodingHistoryItems, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.DecodingHistoryItems.Count, Converter={StaticResource EmptyCollectionToVisibility}, ConverterParameter=true, Mode=OneWay}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ReorderThemeTransition />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DecodingHistoryItem">
                    <Grid
                        Margin="0,4"
                        ColumnSpacing="8"
                        RowSpacing="0">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="DecodingHistoryPaneContentControl_RemoveMenuItem" Click="RemoveDecodingHistoryItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Delete" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Thumbnail  -->
                        <Border
                            Width="56"
                            Height="56"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <Image Source="{x:Bind SavedImagePath, Converter={StaticResource FilePathToImage}}" Stretch="Uniform" />
                        </Border>

                        <!--  Info  -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{x:Bind helpers:LocalizedDisplay.DecodingSourceName(SourceKind, SourceFilePath)}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind helpers:LocalizedDisplay.FirstDecodedText(DecodedTexts)}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontStyle="Italic"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind helpers:LocalizedDisplay.DecodedCountSuffix(DecodedTexts)}" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SaveDateAsString}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
