<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.QrExportActionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Simple_QR_Code_Maker.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsed" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel
        HorizontalAlignment="Center"
        Orientation="Vertical"
        Spacing="8">
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10"
            Visibility="{x:Bind ViewModel.HasRequestedCodes, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <TextBlock x:Uid="QrExportActionsControl_SaveAsText" VerticalAlignment="Center" />
            <SplitButton x:Uid="QrExportActionsControl_SaveCodeSAsPNGSplitButton" Command="{x:Bind ViewModel.SavePngCommand}">
                <SplitButton.Content>
                    <local:IconAndTextContent x:Uid="QrExportActionsControl_PNGIconAndTextContent" Icon="Save" />
                </SplitButton.Content>
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_SaveAllToFilesDefaultMenuItem"
                            Command="{x:Bind ViewModel.SavePngCommand}"
                            Icon="SaveLocal" />
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_SaveAllToZipMenuItem"
                            Command="{x:Bind ViewModel.SavePngAsZipCommand}"
                            Icon="SaveLocal"
                            Visibility="{x:Bind ViewModel.ShowZipSaveOptions, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_CopyAllToClipboardMenuItem"
                            Command="{x:Bind ViewModel.CopyPngToClipboardCommand}"
                            Icon="Copy"
                            IsEnabled="{x:Bind ViewModel.IsBulkClipboardEnabled, Mode=OneWay}" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <SplitButton x:Uid="QrExportActionsControl_SaveCodeSAsSVGSplitButton" Command="{x:Bind ViewModel.SaveSvgCommand}">
                <SplitButton.Content>
                    <local:IconAndTextContent x:Uid="QrExportActionsControl_SVGIconAndTextContent" Icon="Save" />
                </SplitButton.Content>
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_SaveAllToFilesDefaultMenuItem2"
                            Command="{x:Bind ViewModel.SaveSvgCommand}"
                            Icon="SaveLocal" />
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_SaveAllToZipMenuItem2"
                            Command="{x:Bind ViewModel.SaveSvgAsZipCommand}"
                            Icon="SaveLocal"
                            Visibility="{x:Bind ViewModel.ShowZipSaveOptions, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_CopyAllToClipboardMenuItem2"
                            Command="{x:Bind ViewModel.CopySvgToClipboardCommand}"
                            Icon="Copy"
                            IsEnabled="{x:Bind ViewModel.IsBulkClipboardEnabled, Mode=OneWay}" />
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_CopyAllAsTextToMenuItem"
                            Command="{x:Bind ViewModel.CopySvgTextToClipboardCommand}"
                            Icon="Copy"
                            IsEnabled="{x:Bind ViewModel.IsBulkClipboardEnabled, Mode=OneWay}" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <SplitButton
                x:Uid="QrExportActionsControl_SaveCodeSAsBothSplitButton"
                Command="{x:Bind ViewModel.SaveBothCommand}"
                Visibility="{x:Bind ViewModel.ShowSaveBothButton, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <SplitButton.Content>
                    <local:IconAndTextContent x:Uid="QrExportActionsControl_BothIconAndTextContent" Icon="Save" />
                </SplitButton.Content>
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_SaveAllToFilesDefaultMenuItem3"
                            Command="{x:Bind ViewModel.SaveBothCommand}"
                            Icon="SaveLocal" />
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_SaveAllToZipMenuItem3"
                            Command="{x:Bind ViewModel.SaveBothAsZipCommand}"
                            Icon="SaveLocal"
                            Visibility="{x:Bind ViewModel.ShowZipSaveOptions, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <MenuFlyoutItem
                            x:Uid="QrExportActionsControl_CopyAllToClipboardMenuItem3"
                            Command="{x:Bind ViewModel.CopyBothToClipboardCommand}"
                            Icon="Copy"
                            IsEnabled="{x:Bind ViewModel.IsBulkClipboardEnabled, Mode=OneWay}" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Button
                x:Uid="QrExportActionsControl_PrintQRCodeSButton"
                Command="{x:Bind ViewModel.PrintCommand}"
                Visibility="{x:Bind ViewModel.ShowPrintButton, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <local:IconAndTextContent x:Uid="QrExportActionsControl_PrintIconAndTextContent" Icon="Print" />
            </Button>
            <Button
                x:Uid="QrExportActionsControl_QuicklyShowOrHideExportButton"
                Width="32"
                Height="32"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Button.Flyout>
                    <MenuFlyout>
                        <ToggleMenuFlyoutItem
                            x:Uid="QrExportActionsControl_ShowSaveBothButtonToggleMenuFlyoutItem"
                            Command="{x:Bind ViewModel.ToggleSaveBothButtonVisibilityCommand}"
                            IsChecked="{x:Bind ViewModel.ShowSaveBothButton, Mode=OneWay}">
                            <ToggleMenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Save" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            x:Uid="QrExportActionsControl_ShowPrintButtonToggleMenuFlyoutItem"
                            Command="{x:Bind ViewModel.TogglePrintButtonVisibilityCommand}"
                            IsChecked="{x:Bind ViewModel.ShowPrintButton, Mode=OneWay}">
                            <ToggleMenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Print" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE712;" />
            </Button>
            <FontIcon
                Glyph="&#xE946;"
                ToolTipService.ToolTip="{x:Bind ViewModel.BulkClipboardRestrictionText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.BulkClipboardRestrictionText, Converter={StaticResource EmptyStringToCollapsed}, Mode=OneWay}" />
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsBulkOperationRunning, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="True" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.BulkOperationStatusText, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
