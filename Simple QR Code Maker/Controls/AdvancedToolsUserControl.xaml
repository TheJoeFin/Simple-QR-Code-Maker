<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.AdvancedToolsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Simple_QR_Code_Maker.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingsControls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <x:Double x:Key="SettingsCardWrapThreshold">320</x:Double>
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">200</x:Double>

        <Style x:Key="WorkflowLauncherButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ScrollViewer
                Padding="16,16,16,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.IsWorkflowPickerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="20">
                                <SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Symbol="Repair" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock x:Uid="AdvancedToolsUserControl_AdvancedDecodingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="AdvancedToolsUserControl_ChooseAFocusedWorkflowOrText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <settingsControls:SettingsExpander x:Uid="AdvancedToolsUserControl_QuickFixesSettingsExpander" IsExpanded="True">
                        <settingsControls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </settingsControls:SettingsExpander.HeaderIcon>
                        <settingsControls:SettingsExpander.Items>
                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_OneTapFixesSettingsCard">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Uid="AdvancedToolsUserControl_ConvertTheImageToGrayscaleButton"
                                        Grid.Column="0"
                                        Width="360"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind ViewModel.ApplyGrayscaleCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                                            <TextBlock x:Uid="AdvancedToolsUserControl_GrayscaleText" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Uid="AdvancedToolsUserControl_InvertImageColorsWhenTheButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind ViewModel.ApplyInvertCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE771;" />
                                            <TextBlock x:Uid="AdvancedToolsUserControl_InvertText" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_ContrastSettingsCard">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="ContrastSlider"
                                        x:Uid="AdvancedToolsUserControl_ContrastSlider"
                                        Grid.Column="0"
                                        Maximum="100"
                                        Minimum="-100"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.ContrastValue, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.ContrastValue, Mode=OneWay}" />
                                </Grid>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_BlackPointSettingsCard">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="BlackPointSlider"
                                        x:Uid="AdvancedToolsUserControl_BlackPointSlider"
                                        Grid.Column="0"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.BlackPointLevel, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.BlackPointLevel, Mode=OneWay}" />
                                </Grid>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_WhitePointSettingsCard">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="WhitePointSlider"
                                        x:Uid="AdvancedToolsUserControl_WhitePointSlider"
                                        Grid.Column="0"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.WhitePointLevel, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.WhitePointLevel, Mode=OneWay}" />
                                </Grid>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_AddBorderSettingsCard">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="BorderPercentSlider"
                                        x:Uid="AdvancedToolsUserControl_BorderPercentSlider"
                                        Grid.Column="0"
                                        Maximum="50"
                                        Minimum="0"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.BorderPercent, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.BorderPercent, Mode=OneWay}" />
                                </Grid>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_ApplyQuickFixesSettingsCard">
                                <Button
                                    x:Uid="AdvancedToolsUserControl_ApplyTheCurrentQuickFixButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ApplyProcessingCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="16" Height="16">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                Glyph="&#xE73E;"
                                                Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}" />
                                            <ProgressRing
                                                Width="16"
                                                Height="16"
                                                IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>

                                        <TextBlock
                                            x:Uid="AdvancedToolsUserControl_ApplyQuickFixesText"
                                            Grid.Column="1"
                                            TextWrapping="Wrap" />

                                        <Ellipse
                                            Grid.Column="2"
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Visibility="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </settingsControls:SettingsCard>
                        </settingsControls:SettingsExpander.Items>
                    </settingsControls:SettingsExpander>

                    <settingsControls:SettingsExpander x:Uid="AdvancedToolsUserControl_GuidedWorkflowsSettingsExpander" IsExpanded="True">
                        <settingsControls:SettingsExpander.HeaderIcon>
                            <SymbolIcon Symbol="Edit" />
                        </settingsControls:SettingsExpander.HeaderIcon>
                        <settingsControls:SettingsExpander.Items>
                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_SampleBlackPointSettingsCard">
                                <Button
                                    x:Uid="AdvancedToolsUserControl_OpenTheBlackPointSamplingButton"
                                    Command="{x:Bind ViewModel.OpenBlackPointWorkflowCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    Style="{StaticResource WorkflowLauncherButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEF3C;" />
                                        <TextBlock x:Uid="AdvancedToolsUserControl_PickBlackPointText" />
                                    </StackPanel>
                                </Button>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_SampleWhitePointSettingsCard">
                                <Button
                                    x:Uid="AdvancedToolsUserControl_OpenTheWhitePointSamplingButton"
                                    Command="{x:Bind ViewModel.OpenWhitePointWorkflowCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    Style="{StaticResource WorkflowLauncherButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEF3C;" />
                                        <TextBlock x:Uid="AdvancedToolsUserControl_PickWhitePointText" />
                                    </StackPanel>
                                </Button>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_StraightenAQRCodeSettingsCard">
                                <Button
                                    x:Uid="AdvancedToolsUserControl_OpenThePerspectiveCorrectionWorkflowButton"
                                    Command="{x:Bind ViewModel.OpenPerspectiveWorkflowCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    Style="{StaticResource WorkflowLauncherButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:QrCodeIcon />
                                        <TextBlock x:Uid="AdvancedToolsUserControl_PickCodeCornersText" />
                                    </StackPanel>
                                </Button>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_ExtractARegionSettingsCard">
                                <Button
                                    x:Uid="AdvancedToolsUserControl_OpenTheExtractRegionWorkflowButton"
                                    Command="{x:Bind ViewModel.OpenCutOutWorkflowCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    Style="{StaticResource WorkflowLauncherButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Crop" />
                                        <TextBlock x:Uid="AdvancedToolsUserControl_CutoutAreaText" />
                                    </StackPanel>
                                </Button>
                            </settingsControls:SettingsCard>

                            <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_UnwarpAQRCodeSettingsCard">
                                <Button
                                    x:Uid="AdvancedToolsUserControl_OpenTheUnwarpWorkflowToButton"
                                    Command="{x:Bind ViewModel.OpenUnwarpWorkflowCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    Style="{StaticResource WorkflowLauncherButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xF207;" />
                                        <TextBlock x:Uid="AdvancedToolsUserControl_PickUnwarpPointsText" />
                                    </StackPanel>
                                </Button>
                            </settingsControls:SettingsCard>
                        </settingsControls:SettingsExpander.Items>
                    </settingsControls:SettingsExpander>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                Padding="16,16,16,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.IsSampleBlackPointWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="AdvancedToolsUserControl_SampleBlackPointText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="AdvancedToolsUserControl_ClickTheDarkestMeaningfulPartText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Uid="AdvancedToolsUserControl_ClickOnceOnTheImageInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                Padding="16,16,16,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.IsSampleWhitePointWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="AdvancedToolsUserControl_SampleWhitePointText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="AdvancedToolsUserControl_ClickTheLightestMeaningfulPartText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Uid="AdvancedToolsUserControl_ClickOnceOnTheImageInfoBar2"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                Padding="16,16,16,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.IsPerspectiveWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="AdvancedToolsUserControl_StraightenAQRCodeText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="AdvancedToolsUserControl_WorkThroughTheCornerSelectionText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Uid="AdvancedToolsUserControl_ClickEachCornerOnTheInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_CurrentStepSettingsCard">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="28"
                                Height="28"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="14"
                                Visibility="{x:Bind ViewModel.IsCornerSelectionComplete, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CurrentCornerNumber, Mode=OneWay}" />
                            </Border>

                            <Border
                                Width="28"
                                Height="28"
                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                CornerRadius="14"
                                Visibility="{x:Bind ViewModel.IsCornerSelectionComplete, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE73E;" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.CurrentCornerInstruction, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </settingsControls:SettingsCard>

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_BorderSizeSettingsCard">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="BorderSlider"
                                x:Uid="AdvancedToolsUserControl_BorderSlider"
                                Grid.Column="0"
                                Maximum="50"
                                Minimum="0"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.BorderPixels, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="40"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.BorderPixels, Mode=OneWay}" />
                        </Grid>
                    </settingsControls:SettingsCard>

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_SelectionSettingsCard">
                        <Button
                            x:Uid="AdvancedToolsUserControl_ClearAllSelectedCornersAndButton"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ClearPerspectiveCornersCommand}">
                            <TextBlock x:Uid="AdvancedToolsUserControl_ClearCornersText" />
                        </Button>
                    </settingsControls:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                Padding="16,16,16,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.IsUnwarpWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="AdvancedToolsUserControl_UnwarpAQRCodeText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="AdvancedToolsUserControl_SetTheQRVersionClickText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Uid="AdvancedToolsUserControl_ClickOnTheImageToInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_QRCodeVersionSettingsCard">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Uid="AdvancedToolsUserControl_SelectTheQRCodeVersionSlider"
                                Grid.Column="0"
                                Maximum="40"
                                Minimum="10"
                                StepFrequency="5"
                                Value="{x:Bind ViewModel.QrVersionDouble, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="28"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.QrVersion, Mode=OneWay}" />
                        </Grid>
                    </settingsControls:SettingsCard>

                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Uid="AdvancedToolsUserControl_PointLayoutText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <Border
                                Width="140"
                                Height="140"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Canvas
                                    x:Name="UnwarpPreviewCanvas"
                                    Width="140"
                                    Height="140"
                                    PointerPressed="UnwarpPreviewCanvas_PointerPressed" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.UnwarpPointSummary, Mode=OneWay}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_CurrentStepSettingsCard2">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="28"
                                Height="28"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="14"
                                Visibility="{x:Bind ViewModel.IsUnwarpComplete, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.PlacedCount, Mode=OneWay}" />
                            </Border>

                            <Border
                                Width="28"
                                Height="28"
                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                CornerRadius="14"
                                Visibility="{x:Bind ViewModel.IsUnwarpComplete, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE73E;" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.CurrentUnwarpInstruction, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </settingsControls:SettingsCard>

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_UseEstimatedPositionSettingsCard" Visibility="{x:Bind ViewModel.IsNextUnwarpPointAlignment, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button
                            x:Uid="AdvancedToolsUserControl_AcceptTheCalculatedBilinearPositionButton"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.UseEstimatedUnwarpPointCommand}">
                            <TextBlock x:Uid="AdvancedToolsUserControl_UseEstimatedText" />
                        </Button>
                    </settingsControls:SettingsCard>

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_PointsSettingsCard">
                        <Button
                            x:Uid="AdvancedToolsUserControl_ClearAllPlacedPointsAndButton"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ClearUnwarpPointsCommand}">
                            <TextBlock x:Uid="AdvancedToolsUserControl_ClearAllPointsText" />
                        </Button>
                    </settingsControls:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                Padding="16,16,16,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.IsCutOutWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="AdvancedToolsUserControl_ExtractARegionText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="AdvancedToolsUserControl_DragOverTheImageToText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Uid="AdvancedToolsUserControl_ClickAndDragOnTheInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_SelectionStatusSettingsCard">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Uid="AdvancedToolsUserControl_NoRegionSelectedYetText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasCutOutSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}" />

                            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasCutOutSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="28"
                                    Height="28"
                                    Background="{ThemeResource SystemFillColorSuccessBrush}"
                                    CornerRadius="14">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE73E;" />
                                </Border>

                                <TextBlock
                                    x:Uid="AdvancedToolsUserControl_RegionSelectedAndReadyToText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </settingsControls:SettingsCard>

                    <settingsControls:SettingsCard x:Uid="AdvancedToolsUserControl_SelectionSettingsCard2">
                        <Button
                            x:Uid="AdvancedToolsUserControl_ClearTheCurrentRegionSelectionButton"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ClearCutOutSelectionCommand}">
                            <TextBlock x:Uid="AdvancedToolsUserControl_ClearSelectionText" />
                        </Button>
                    </settingsControls:SettingsCard>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.IsWorkflowPickerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Uid="AdvancedToolsUserControl_ResetAllQuickFixSettingsButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ResetAllSettingsCommand}"
                    IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                    <TextBlock x:Uid="AdvancedToolsUserControl_ResetAllText" />
                </Button>

                <local:IconAndTextHyperlinkButton
                    x:Uid="AdvancedToolsUserControl_UndoIconAndTextHyperlinkButton"
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.UndoCommand}">
                    <local:IconAndTextHyperlinkButton.IconSource>
                        <SymbolIconSource Symbol="Undo" />
                    </local:IconAndTextHyperlinkButton.IconSource>
                </local:IconAndTextHyperlinkButton>

                <local:IconAndTextHyperlinkButton
                    x:Uid="AdvancedToolsUserControl_RedoIconAndTextHyperlinkButton"
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.RedoCommand}"
                    Visibility="Collapsed">
                    <local:IconAndTextHyperlinkButton.IconSource>
                        <SymbolIconSource Symbol="Redo" />
                    </local:IconAndTextHyperlinkButton.IconSource>
                </local:IconAndTextHyperlinkButton>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.IsSampleBlackPointWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button
                x:Uid="AdvancedToolsUserControl_CancelButton"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.CancelWorkflowCommand}" />
        </Border>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.IsSampleWhitePointWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button
                x:Uid="AdvancedToolsUserControl_CancelButton2"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.CancelWorkflowCommand}" />
        </Border>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.IsPerspectiveWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    x:Uid="AdvancedToolsUserControl_ApplyCorrectionButton"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ApplyProcessingCommand}"
                    IsEnabled="{x:Bind ViewModel.CanApplyPerspectiveWorkflow, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Uid="AdvancedToolsUserControl_ClearCornersButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ClearPerspectiveCornersCommand}" />
                    <Button
                        x:Uid="AdvancedToolsUserControl_CancelButton3"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CancelWorkflowCommand}" />
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.IsCutOutWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    x:Uid="AdvancedToolsUserControl_ExtractTheSelectedRegionAndButton"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.PerformCutOutCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Crop" />
                        <TextBlock x:Uid="AdvancedToolsUserControl_ExtractRegionText" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Uid="AdvancedToolsUserControl_ClearSelectionButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ClearCutOutSelectionCommand}" />
                    <Button
                        x:Uid="AdvancedToolsUserControl_CancelButton4"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CancelWorkflowCommand}" />
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.IsUnwarpWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    x:Uid="AdvancedToolsUserControl_ApplyPolynomialUnwarpCorrectionAndButton"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ApplyUnwarpCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF207;" />
                        <TextBlock x:Uid="AdvancedToolsUserControl_ApplyUnwarpText" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Uid="AdvancedToolsUserControl_ClearPointsButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ClearUnwarpPointsCommand}" />
                    <Button
                        x:Uid="AdvancedToolsUserControl_CancelButton5"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CancelWorkflowCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Z"
            Invoked="UndoAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Y"
            Invoked="RedoAccelerator_Invoked"
            Modifiers="Control" />
    </UserControl.KeyboardAccelerators>
</UserControl>
