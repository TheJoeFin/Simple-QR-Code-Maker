<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Simple_QR_Code_Maker.Controls.QrDesignGalleryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Simple_QR_Code_Maker.Controls"
    Unloaded="Control_Unloaded">
    <Button
        x:Name="DesignButton"
        x:Uid="QrDesignGalleryControl_DesignButton"
        AutomationProperties.AutomationId="QrDesignButton"
        Click="DesignButton_Click">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Viewbox Width="16" Height="16">
                <controls:FrameIcon />
            </Viewbox>
            <TextBlock x:Uid="QrDesignGalleryControl_DesignText" />
        </StackPanel>
    </Button>
</UserControl>
