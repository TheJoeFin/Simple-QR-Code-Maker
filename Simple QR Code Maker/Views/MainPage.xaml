<Page
    x:Class="Simple_QR_Code_Maker.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Simple_QR_Code_Maker.Behaviors"
    xmlns:controls="using:Simple_QR_Code_Maker.Controls"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    xmlns:toolkitControls="using:CommunityToolkit.WinUI.Controls"
    Name="EncodingPage"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:TextHasNoURLConverter x:Key="HasNoURL" />
        <converters:ColorToBrushConverter x:Key="ColorToBrush" />
        <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsed" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibility" />

        <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="32" />
        </Style>
    </Page.Resources>

    <SplitView
        DisplayMode="Overlay"
        IsPaneOpen="{x:Bind ViewModel.IsFaqPaneOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        OpenPaneLength="500"
        PanePlacement="Left">
        <SplitView.Pane>
            <controls:FaqsContent />
        </SplitView.Pane>
        <SplitView.Content>
            <SplitView
                DisplayMode="Overlay"
                IsPaneOpen="{x:Bind ViewModel.IsHistoryPaneOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                OpenPaneLength="400"
                PanePlacement="Right">
                <SplitView.Content>
                    <Grid x:Name="PageRootGrid">
                        <ScrollViewer
                            x:Name="MainContentScrollViewer"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <Grid Margin="20">
                                <StackPanel
                                    x:Name="MainContentStackPanel"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <controls:BrandPickerControl x:Name="BrandPickerArea" ViewModel="{x:Bind ViewModel}" />

                                    <Grid
                                        x:Name="QrCodeInputRow"
                                        HorizontalAlignment="Stretch"
                                        ColumnSpacing="10"
                                        SizeChanged="QrCodeInputRow_SizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="UrlTextBox"
                                            Grid.Column="0"
                                            MinWidth="0"
                                            MaxWidth="800"
                                            HorizontalAlignment="Stretch"
                                            AcceptsReturn="True"
                                            PlaceholderText="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                            Text="{x:Bind ViewModel.UrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="UrlTextBox_TextChanged"
                                            TextWrapping="NoWrap" />
                                        <Button
                                            x:Name="UrlImportButton"
                                            x:Uid="MainPage_UrlImportButton"
                                            Grid.Column="1"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,0,-1"
                                            Padding="0"
                                            VerticalAlignment="Bottom"
                                            Click="UrlImportButton_Click">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="Bottom">
                                                    <MenuFlyoutItem
                                                        x:Uid="MainPage_PasteMenuItem"
                                                        Command="{x:Bind ViewModel.PasteTextIntoUrlTextCommand}"
                                                        IsEnabled="{x:Bind ViewModel.CanPasteText, Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon>
                                                            <SymbolIcon Symbol="Paste" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="MainPage_BuildURLMenuItem" Command="{x:Bind ViewModel.OpenUrlBuilderCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE71B;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="MainPage_BuildVCardMenuItem" Command="{x:Bind ViewModel.OpenVCardBuilderCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <SymbolIcon Symbol="Contact" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="MainPage_BuildWiFiMenuItem" Command="{x:Bind ViewModel.OpenWifiBuilderCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE701;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="MainPage_BuildEmailMenuItem" Command="{x:Bind ViewModel.OpenEmailBuilderCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <SymbolIcon Symbol="Mail" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="MainPage_GenerateIDsMenuItem" Command="{x:Bind ViewModel.OpenGenerateIdsDialogCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <SymbolIcon Symbol="Bullets" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem x:Uid="MainPage_OpenTextFileMenuItem" Command="{x:Bind ViewModel.OpenTextFileCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8A5;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="MainPage_OpenSpreadsheetMenuItem" Command="{x:Bind ViewModel.OpenSpreadsheetFileCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xF232;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <ToggleMenuFlyoutItem
                                                        x:Uid="MainPage_MultiLineCodesToggleMenuFlyoutItem"
                                                        Click="VCardSingleCodeDefault_Click"
                                                        IsChecked="{x:Bind ViewModel.UseSingleCodeForCurrentDocument, Mode=OneWay}">
                                                        <ToggleMenuFlyoutItem.Icon>
                                                            <SymbolIcon Symbol="Bullets" />
                                                        </ToggleMenuFlyoutItem.Icon>
                                                    </ToggleMenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <Viewbox Width="16" Height="16">
                                                <SymbolIcon Symbol="Add" />
                                            </Viewbox>
                                        </Button>
                                    </Grid>

                                    <StackPanel
                                        x:Name="QrCodeOptions"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Visibility="{x:Bind ViewModel.CanSaveImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <interactivity:Interaction.Behaviors>
                                            <behaviors:ImplicitVisibilityAnimationBehavior />
                                        </interactivity:Interaction.Behaviors>
                                        <controls:ColorPickerButton
                                            x:Uid="MainPage_CodeColorColorPickerButton"
                                            BrandColorItems="{x:Bind ViewModel.ForegroundBrandColorItems, Mode=OneWay}"
                                            DefaultImagePath="{x:Bind ViewModel.CurrentLogoPath, Mode=OneWay}"
                                            RecentColorItems="{x:Bind ViewModel.ForegroundRecentColorItems, Mode=OneWay}"
                                            Color="{x:Bind ViewModel.ForegroundColor, Mode=TwoWay}">
                                            <controls:ColorPickerButton.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Uid="MainPage_SetAsDefaultCodeColorMenuItem" Command="{x:Bind ViewModel.SetForegroundAsDefaultCommand}" />
                                                </MenuFlyout>
                                            </controls:ColorPickerButton.ContextFlyout>
                                            <controls:ColorPickerButton.ButtonContent>
                                                <Viewbox Width="18" Height="18">
                                                    <controls:QrCodeIcon Foreground="{x:Bind ViewModel.ForegroundColor, Mode=OneWay, Converter={StaticResource ColorToBrush}}" />
                                                </Viewbox>
                                            </controls:ColorPickerButton.ButtonContent>
                                        </controls:ColorPickerButton>
                                        <controls:ColorPickerButton
                                            x:Uid="MainPage_BackgroundColorColorPickerButton"
                                            BrandColorItems="{x:Bind ViewModel.BackgroundBrandColorItems, Mode=OneWay}"
                                            DefaultImagePath="{x:Bind ViewModel.CurrentLogoPath, Mode=OneWay}"
                                            RecentColorItems="{x:Bind ViewModel.BackgroundRecentColorItems, Mode=OneWay}"
                                            Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}">
                                            <controls:ColorPickerButton.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Uid="MainPage_SetAsDefaultBackgroundColorMenuItem" Command="{x:Bind ViewModel.SetBackgroundAsDefaultCommand}" />
                                                </MenuFlyout>
                                            </controls:ColorPickerButton.ContextFlyout>
                                        </controls:ColorPickerButton>
                                        <DropDownButton x:Uid="MainPage_LevelOfErrorCorrectionDropDownButton" Width="60">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedOption.ShortDescription, Mode=OneWay}" />
                                            <DropDownButton.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Uid="MainPage_SetAsDefaultErrorCorrectionMenuItem" Command="{x:Bind ViewModel.SetErrorCorrectionAsDefaultCommand}" />
                                                </MenuFlyout>
                                            </DropDownButton.ContextFlyout>
                                            <DropDownButton.Flyout>
                                                <Flyout x:Name="ErrorCorrectionFlyout" Placement="Bottom">
                                                    <StackPanel Spacing="8">
                                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ErrorCorrectionLevels, Mode=OneWay}">
                                                            <ItemsRepeater.Layout>
                                                                <StackLayout Spacing="2" />
                                                            </ItemsRepeater.Layout>
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ErrorCorrectionOptions">
                                                                    <Button
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left"
                                                                        Click="ErrorCorrectionItem_Click"
                                                                        Content="{x:Bind Description}"
                                                                        Tag="{x:Bind}" />
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                        <HyperlinkButton Click="WhatIsErrorCorrection_Click" FontSize="12">
                                                            <TextBlock x:Uid="MainPage_WhatIsErrorCorrectionText" />
                                                        </HyperlinkButton>
                                                    </StackPanel>
                                                </Flyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <controls:QrLogoDesignerControl ViewModel="{x:Bind ViewModel}" />
                                        <controls:BrandManagementControl x:Name="BrandMgmtControl" ViewModel="{x:Bind ViewModel}" />
                                        <controls:QrDesignGalleryControl ViewModel="{x:Bind ViewModel}" />
                                    </StackPanel>

                                    <StackPanel x:Name="CodesSection" HorizontalAlignment="Stretch">
                                        <Border
                                            x:Name="CodesBorder"
                                            MinWidth="300"
                                            MinHeight="300"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Viewbox
                                                    Height="100"
                                                    Opacity="0.7"
                                                    Visibility="{x:Bind ViewModel.QrCodeBitmaps.Count, Mode=OneWay, Converter={StaticResource EmptyCollectionToVisibility}}">
                                                    <controls:QrCodeIcon />
                                                </Viewbox>
                                                <ItemsControl
                                                    x:Name="ListOfCodes"
                                                    HorizontalAlignment="Stretch"
                                                    ItemsSource="{x:Bind ViewModel.QrCodeBitmaps, Mode=OneWay}">
                                                    <ItemsControl.ItemContainerTransitions>
                                                        <TransitionCollection>
                                                            <AddDeleteThemeTransition />
                                                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                                                        </TransitionCollection>
                                                    </ItemsControl.ItemContainerTransitions>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <toolkitControls:WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BarcodeImageItem">
                                                            <controls:QrCodeImageControl Data="{x:Bind}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>

                                        <!--  If there are more than 24 codes show this UI below  -->
                                        <StackPanel Orientation="Vertical" Visibility="{x:Bind ViewModel.CanLoadMorePreviews, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                            <interactivity:Interaction.Behaviors>
                                                <behaviors:ImplicitVisibilityAnimationBehavior />
                                            </interactivity:Interaction.Behaviors>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.PreviewSummaryText, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.PreviewSummaryText, Converter={StaticResource EmptyStringToCollapsed}, Mode=OneWay}" />
                                            <HyperlinkButton
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                Command="{x:Bind ViewModel.LoadMorePreviewsCommand}"
                                                Visibility="{x:Bind ViewModel.CanLoadMorePreviews, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="Download" />
                                                    <TextBlock x:Uid="MainPage_LoadMoreText" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </StackPanel>
                                    </StackPanel>

                                    <controls:QrExportActionsControl
                                        Name="SaveButtons"
                                        ViewModel="{x:Bind ViewModel}"
                                        Visibility="{x:Bind ViewModel.HasRequestedCodes, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <interactivity:Interaction.Behaviors>
                                            <behaviors:ImplicitVisibilityAnimationBehavior />
                                        </interactivity:Interaction.Behaviors>
                                    </controls:QrExportActionsControl>

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Visibility="{x:Bind ViewModel.ShowMainNavigationButtons, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <controls:IconAndTextButton x:Uid="MainPage_ReadCodesIconAndTextButton" Command="{x:Bind ViewModel.OpenFileCommand}">
                                            <controls:IconAndTextButton.Icon>
                                                <controls:ScanIcon />
                                            </controls:IconAndTextButton.Icon>
                                        </controls:IconAndTextButton>
                                        <controls:IconAndTextButton x:Uid="MainPage_SettingsIconAndTextButton" Command="{x:Bind ViewModel.GoToSettingsCommand}">
                                            <controls:IconAndTextButton.IconSource>
                                                <SymbolIconSource Symbol="Setting" />
                                            </controls:IconAndTextButton.IconSource>
                                        </controls:IconAndTextButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Button
                            x:Name="ScrollToCodesButton"
                            x:Uid="MainPage_ScrollToCodesButton"
                            Height="40"
                            MinWidth="168"
                            Padding="16,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="ScrollToCodesButton_Click"
                            CornerRadius="16"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:ImplicitVisibilityAnimationBehavior />
                            </interactivity:Interaction.Behaviors>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74B;" />
                                <TextBlock x:Uid="MainPage_ScrollToCodesText" />
                            </StackPanel>
                        </Button>

                        <InfoBar
                            x:Name="LenghErrorInfoBar"
                            Title="{x:Bind ViewModel.CodeInfoBarTitle, Mode=OneWay}"
                            MaxWidth="600"
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            IsOpen="{x:Bind ViewModel.ShowCodeInfoBar, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.CodeInfoBarMessage, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.CodeInfoBarSeverity, Mode=OneWay}">
                            <InfoBar.Content>
                                <StackPanel
                                    Padding="0,0,0,10"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <HyperlinkButton
                                        x:Uid="MainPage_OpenFolderHyperlinkButton"
                                        Command="{x:Bind ViewModel.OpenSavedFolderCommand}"
                                        Visibility="{x:Bind ViewModel.SavedFolderPath, Converter={StaticResource EmptyStringToCollapsed}, Mode=OneWay}" />
                                    <HyperlinkButton
                                        Command="{x:Bind ViewModel.MarkRedirectorDomainSafeCommand}"
                                        Content="{x:Bind ViewModel.RedirectorSafeActionText, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ShowMarkRedirectorSafeAction, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                    <controls:IconAndTextHyperlinkButton
                                        x:Uid="MainPage_SettingsIconAndTextHyperlinkButton"
                                        Command="{x:Bind ViewModel.GoToSettingsCommand}"
                                        Visibility="{x:Bind ViewModel.ShowRedirectorSettingsAction, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <controls:IconAndTextHyperlinkButton.IconSource>
                                            <SymbolIconSource Symbol="Setting" />
                                        </controls:IconAndTextHyperlinkButton.IconSource>
                                    </controls:IconAndTextHyperlinkButton>
                                </StackPanel>
                            </InfoBar.Content>
                        </InfoBar>

                        <TeachingTip
                            x:Name="AddButtonTeachingTip"
                            x:Uid="MainPage_AddButtonTeachingTip"
                            Closed="AddButtonTeachingTip_Closed"
                            IsOpen="{x:Bind ViewModel.ShowAddButtonTeachingTip, Mode=OneWay}"
                            PreferredPlacement="BottomRight"
                            Target="{x:Bind UrlImportButton}" />

                        <TeachingTip
                            x:Name="HistoryButtonTeachingTip"
                            x:Uid="MainPage_HistoryButtonTeachingTip"
                            Closed="HistoryButtonTeachingTip_Closed"
                            IsOpen="{x:Bind ViewModel.ShowHistoryButtonTeachingTip, Mode=OneWay}"
                            PreferredPlacement="Bottom" />

                        <TeachingTip
                            x:Name="BrandButtonTeachingTip"
                            x:Uid="MainPage_BrandButtonTeachingTip"
                            Closed="BrandButtonTeachingTip_Closed"
                            IsOpen="{x:Bind ViewModel.ShowBrandButtonTeachingTip, Mode=OneWay}"
                            PreferredPlacement="Bottom"
                            Target="{x:Bind BrandMgmtControl}" />

                        <TeachingTip
                            x:Name="BrandUrlWarningTip"
                            x:Uid="MainPage_BrandUrlWarningTip"
                            Closed="BrandUrlWarningTip_Closed"
                            IsOpen="{x:Bind ViewModel.ShowBrandUrlWarningTip, Mode=OneWay}"
                            PreferredPlacement="Bottom"
                            Target="{x:Bind BrandPickerArea}" />
                    </Grid>
                </SplitView.Content>
                <SplitView.Pane>
                    <controls:HistoryPaneContentControl ViewModel="{x:Bind ViewModel}" />
                </SplitView.Pane>
            </SplitView>
        </SplitView.Content>
    </SplitView>
</Page>
