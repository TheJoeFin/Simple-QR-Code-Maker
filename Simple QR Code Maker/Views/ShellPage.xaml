<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Simple_QR_Code_Maker.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Simple_QR_Code_Maker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Simple_QR_Code_Maker.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            IsBackButtonVisible="{x:Bind ViewModel.IsBackVisible,
                                         Mode=OneWay}">
            <TitleBar.IconSource>
                <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/WindowIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            ItemInvoked="NavView_ItemInvoked"
            PaneDisplayMode="Top"
            SelectionChanged="NavView_SelectionChanged"
            SelectionFollowsFocus="Disabled">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MakeCodesNavItem"
                    Content="Make Codes"
                    Tag="Make">
                    <NavigationViewItem.Icon>
                        <controls:QrCodeIcon />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ReadCodesNavItem"
                    Content="Read Codes"
                    Tag="Read">
                    <NavigationViewItem.Icon>
                        <controls:ScanIcon />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="FaqNavItem"
                    SelectsOnInvoked="False"
                    Tag="Faq"
                    ToolTipService.ToolTip="Frequently Asked Questions about QR Codes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HistoryNavItem"
                    SelectsOnInvoked="False"
                    Tag="History"
                    ToolTipService.ToolTip="History of previously generated QR Codes">
                    <NavigationViewItem.Icon>
                        <controls:HistoryIcon />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ShareNavItem"
                    SelectsOnInvoked="False"
                    Tag="Share"
                    ToolTipService.ToolTip="Share Simple QR Code Maker">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Share" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="Settings"
                    Tag="Settings"
                    ToolTipService.ToolTip="Simple QR Code Maker Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
                <Frame x:Name="NavigationFrame" />
                <InfoBar
                    x:Name="SharePane"
                    Title="Share Simple QR Code Maker"
                    Margin="32,20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    IsOpen="{x:Bind ViewModel.IsShareOpen,
                                    Mode=TwoWay}">
                    <StackPanel
                        Padding="16"
                        Orientation="Vertical"
                        Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Shop" />
                            <TextBlock Text="Link to the Microsoft Store" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton HorizontalAlignment="Center" Click="VisitLinkButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <SymbolIcon Symbol="Go" />
                                    <TextBlock Text="Visit" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton HorizontalAlignment="Center" Click="CopyLinkButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </InfoBar>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
