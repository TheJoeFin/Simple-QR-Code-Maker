<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Simple_QR_Code_Maker.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Simple_QR_Code_Maker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Simple_QR_Code_Maker.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Simple_QR_Code_Maker.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            IsBackButtonVisible="{x:Bind ViewModel.IsBackVisible, Mode=OneWay}">
            <TitleBar.IconSource>
                <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/WindowIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            ItemInvoked="NavView_ItemInvoked"
            PaneDisplayMode="Top"
            SelectionChanged="NavView_SelectionChanged"
            SelectionFollowsFocus="Disabled">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MakeCodesNavItem"
                    x:Uid="ShellPage_MakeCodesNavItem"
                    Tag="Make">
                    <NavigationViewItem.Icon>
                        <controls:QrCodeIcon />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ReadCodesNavItem"
                    x:Uid="ShellPage_ReadCodesNavItem"
                    Tag="Read">
                    <NavigationViewItem.Icon>
                        <controls:ScanIcon />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="FaqNavItem"
                    x:Uid="ShellPage_FaqNavItem"
                    SelectsOnInvoked="False"
                    Tag="Faq">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HistoryNavItem"
                    x:Uid="ShellPage_HistoryNavItem"
                    x:FieldModifier="public"
                    SelectsOnInvoked="False"
                    Tag="History">
                    <NavigationViewItem.Icon>
                        <controls:HistoryIcon />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ShareNavItem"
                    x:Uid="ShellPage_ShareNavItem"
                    SelectsOnInvoked="False"
                    Tag="Share">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Share" />
                    </NavigationViewItem.Icon>
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Name="ShareContentMenuItem"
                                x:Uid="ShellPage_ShareContentMenuItem"
                                Click="ShareContentMenuItem_Click"
                                Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Share" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="ShellPage_ShareAppMenuItem" Click="ShareAppMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Shop" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    x:Uid="ShellPage_SettingsNavItem"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
                <Frame x:Name="NavigationFrame" />
                <InfoBar
                    x:Name="SharePane"
                    x:Uid="ShellPage_SharePane"
                    Margin="32,20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    IsOpen="{x:Bind ViewModel.IsShareOpen, Mode=TwoWay}">
                    <StackPanel
                        Padding="16"
                        Orientation="Vertical"
                        Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Shop" />
                            <TextBlock x:Uid="ShellPage_LinkToTheMicrosoftStoreText" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton HorizontalAlignment="Center" Click="VisitLinkButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <SymbolIcon Symbol="Go" />
                                    <TextBlock x:Uid="ShellPage_VisitText" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton HorizontalAlignment="Center" Click="CopyLinkButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock x:Uid="ShellPage_CopyText" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </InfoBar>
                <InfoBar
                    x:Name="ShareErrorBar"
                    x:Uid="ShellPage_ShareErrorBar"
                    Margin="32,20"
                    VerticalAlignment="Bottom"
                    Severity="Error" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
