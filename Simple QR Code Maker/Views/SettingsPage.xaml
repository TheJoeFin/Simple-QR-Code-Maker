<Page
    x:Class="Simple_QR_Code_Maker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Simple_QR_Code_Maker.Controls"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingsControls="using:CommunityToolkit.WinUI.Controls"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    x:Name="SettingsPageRoot"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:EnumIsEqualConverter x:Key="EnumIsEqualConverter" />
        <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
        <x:Double x:Key="SettingsCardWrapThreshold">320</x:Double>
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">200</x:Double>
    </Page.Resources>
    <Grid Padding="40,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock x:Uid="Settings_Title" Style="{StaticResource PageTitleStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                x:Name="ContentArea"
                Margin="80,24,80,40"
                HorizontalAlignment="Stretch"
                Spacing="4">

                <!--  Rate and Review  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_RateAndReviewSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE735;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <RatingControl
                        x:Name="AppRatingControl"
                        IsClearEnabled="False"
                        ValueChanged="AppRatingControl_ValueChanged" />
                </settingsControls:SettingsCard>

                <!--  Personalization  -->
                <TextBlock
                    x:Uid="Settings_Personalization"
                    Margin="0,0,0,4"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!--  Theme  -->
                <settingsControls:SettingsExpander x:Uid="SettingsPage_ThemeSettingsExpander" IsExpanded="True">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Uid="Settings_Theme_Light"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    FontSize="15"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=Light, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Light</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                                <RadioButton
                                    x:Uid="Settings_Theme_Dark"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    FontSize="15"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=Dark, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Dark</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                                <RadioButton
                                    x:Uid="Settings_Theme_Default"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    FontSize="15"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=Default, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Default</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                            </StackPanel>
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  Language  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_LanguageSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="LanguageComboBox"
                        x:Uid="SettingsPage_LanguageComboBox"
                        MinWidth="220" />
                </settingsControls:SettingsCard>

                <!--  QR Code Settings  -->
                <TextBlock
                    x:Uid="SettingsPage_QRCodeText"
                    Margin="0,16,0,4"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <settingsControls:SettingsExpander x:Uid="SettingsPage_LaunchModeSettingsExpander" IsExpanded="True">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <controls:QrCodeIcon />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Uid="SettingsPage_CreatingQRCodesRadioButton"
                                    Command="{x:Bind ViewModel.SwitchLaunchModeCommand}"
                                    CommandParameter="CreatingQrCodes"
                                    FontSize="15"
                                    GroupName="LaunchMode"
                                    IsChecked="{x:Bind ViewModel.LaunchMode, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=CreatingQrCodes, Mode=OneWay}" />
                                <RadioButton
                                    x:Uid="SettingsPage_ReadingQRCodesRadioButton"
                                    Command="{x:Bind ViewModel.SwitchLaunchModeCommand}"
                                    CommandParameter="ReadingQrCodes"
                                    FontSize="15"
                                    GroupName="LaunchMode"
                                    IsChecked="{x:Bind ViewModel.LaunchMode, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=ReadingQrCodes, Mode=OneWay}" />
                            </StackPanel>
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  Multi-line handling  -->
                <settingsControls:SettingsExpander x:Uid="SettingsPage_MultiLineHandlingSettingsExpander" IsExpanded="True">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="List" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Uid="SettingsPage_OneCodeForEachLineRadioButton"
                                    Command="{x:Bind ViewModel.SwitchMultiLineModeCommand}"
                                    CommandParameter="OneLineOneCode"
                                    FontSize="15"
                                    GroupName="MultiLineHandling"
                                    IsChecked="{x:Bind ViewModel.MultiLineCodeMode, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=OneLineOneCode, Mode=OneWay}" />
                                <RadioButton
                                    x:Uid="SettingsPage_MultiLineInSingleCodeRadioButton"
                                    Command="{x:Bind ViewModel.SwitchMultiLineModeCommand}"
                                    CommandParameter="MultilineOneCode"
                                    FontSize="15"
                                    GroupName="MultiLineHandling"
                                    IsChecked="{x:Bind ViewModel.MultiLineCodeMode, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=MultilineOneCode, Mode=OneWay}" />
                            </StackPanel>
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  Base text  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_BaseTextSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <TextBox
                        x:Uid="SettingsPage_ExHttpsExampleComTextBox"
                        MinWidth="250"
                        Text="{x:Bind ViewModel.BaseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <!--  Auto brands  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_AutoBrandsSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8F9;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Uid="SettingsPage_OffToggleSwitch" IsOn="{x:Bind ViewModel.UseAutoBrands, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <settingsControls:SettingsCard x:Uid="SettingsPage_RecommendUsingBrandThemesSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8F9;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Uid="SettingsPage_RecommendUsingBrandThemesToggleSwitch"
                        AutomationProperties.AutomationId="RecommendUsingBrandThemesToggle"
                        IsOn="{x:Bind ViewModel.RecommendUsingBrandThemes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <!--  Brand URL on plain-text items  -->
                <settingsControls:SettingsExpander x:Uid="SettingsPage_BrandURLOnPlainTextSettingsExpander">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8F9;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Uid="SettingsPage_IgnoreLeaveExistingContentUnchangedRadioButton"
                                    Command="{x:Bind ViewModel.SwitchBrandUrlMissingBehaviorCommand}"
                                    CommandParameter="Ignore"
                                    FontSize="15"
                                    GroupName="BrandUrlMissingBehavior"
                                    IsChecked="{x:Bind ViewModel.BrandUrlMissingBehavior, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=Ignore, Mode=OneWay}" />
                                <RadioButton
                                    x:Uid="SettingsPage_WarnDefaultShowAnInfoRadioButton"
                                    Command="{x:Bind ViewModel.SwitchBrandUrlMissingBehaviorCommand}"
                                    CommandParameter="Warn"
                                    FontSize="15"
                                    GroupName="BrandUrlMissingBehavior"
                                    IsChecked="{x:Bind ViewModel.BrandUrlMissingBehavior, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=Warn, Mode=OneWay}" />
                                <RadioButton
                                    x:Uid="SettingsPage_AutoPrependAddBrandURLRadioButton"
                                    Command="{x:Bind ViewModel.SwitchBrandUrlMissingBehaviorCommand}"
                                    CommandParameter="AutoPrepend"
                                    FontSize="15"
                                    GroupName="BrandUrlMissingBehavior"
                                    IsChecked="{x:Bind ViewModel.BrandUrlMissingBehavior, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=AutoPrepend, Mode=OneWay}" />
                            </StackPanel>
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  Brand URL mismatch behavior  -->
                <settingsControls:SettingsExpander x:Uid="SettingsPage_BrandURLMismatchSettingsExpander">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8F9;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Uid="SettingsPage_IgnoreKeepExistingURLsRadioButton"
                                    Command="{x:Bind ViewModel.SwitchBrandUrlMismatchBehaviorCommand}"
                                    CommandParameter="Ignore"
                                    FontSize="15"
                                    GroupName="BrandUrlMismatchBehavior"
                                    IsChecked="{x:Bind ViewModel.BrandUrlMismatchBehavior, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=Ignore, Mode=OneWay}" />
                                <RadioButton
                                    x:Uid="SettingsPage_WarnDefaultShowAnInfoRadioButton2"
                                    Command="{x:Bind ViewModel.SwitchBrandUrlMismatchBehaviorCommand}"
                                    CommandParameter="Warn"
                                    FontSize="15"
                                    GroupName="BrandUrlMismatchBehavior"
                                    IsChecked="{x:Bind ViewModel.BrandUrlMismatchBehavior, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=Warn, Mode=OneWay}" />
                                <RadioButton
                                    x:Uid="SettingsPage_AutoFixReplaceNonMatchingRadioButton"
                                    Command="{x:Bind ViewModel.SwitchBrandUrlMismatchBehaviorCommand}"
                                    CommandParameter="AutoFix"
                                    FontSize="15"
                                    GroupName="BrandUrlMismatchBehavior"
                                    IsChecked="{x:Bind ViewModel.BrandUrlMismatchBehavior, Converter={StaticResource EnumIsEqualConverter}, ConverterParameter=AutoFix, Mode=OneWay}" />
                            </StackPanel>
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  URL warnings  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_URLWarningsSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Uid="SettingsPage_OffToggleSwitch2" IsOn="{x:Bind ViewModel.WarnWhenNotUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <settingsControls:SettingsCard x:Uid="SettingsPage_RedirectorWarningsSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Uid="SettingsPage_OffToggleSwitch3" IsOn="{x:Bind ViewModel.WarnWhenLikelyRedirector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <settingsControls:SettingsExpander x:Uid="SettingsPage_SafeRedirectorDomainsSettingsExpander">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE71D;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_KnownSafeDomainsSettingsCard">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SafeRedirectorDomainsEmptyStateText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.SafeRedirectorDomainsEmptyStateText, Converter={StaticResource EmptyStringToCollapsedConverter}, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SafeRedirectorDomains, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind}"
                                                    TextWrapping="Wrap" />
                                                <Button
                                                    x:Uid="SettingsPage_RemoveButton"
                                                    Grid.Column="1"
                                                    Click="RemoveSafeRedirectorDomainButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    x:Uid="SettingsPage_ClearAllButton"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.ClearSafeRedirectorDomainsCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasSafeRedirectorDomains, Mode=OneWay}" />
                            </StackPanel>
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  Minimum size text  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_MinimumSizeTextSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8FF;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Uid="SettingsPage_ShowingToggleSwitch"
                        AutomationProperties.AutomationId="HideMinimumSizeTextToggle"
                        IsOn="{x:Bind ViewModel.HideMinimumSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <!--  Save Both button  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_SaveBothButtonSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74E;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Uid="SettingsPage_HiddenToggleSwitch" IsOn="{x:Bind ViewModel.ShowSaveBothButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <settingsControls:SettingsCard x:Uid="SettingsPage_PrintButtonSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE749;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Uid="SettingsPage_HiddenToggleSwitch2" IsOn="{x:Bind ViewModel.ShowPrintButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <settingsControls:SettingsCard x:Uid="SettingsPage_ZipSaveOptionsSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Uid="SettingsPage_HiddenToggleSwitch3" IsOn="{x:Bind ViewModel.ShowZipSaveOptions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <!--  Max scan distance  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_MaxScanDistanceAtMinimumSettingsCard" Description="{x:Bind ViewModel.MaxScanDistanceText, Mode=OneWay}">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xED5E;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <Slider
                        MinWidth="200"
                        IsThumbToolTipEnabled="False"
                        Maximum="5"
                        Minimum=".35"
                        StepFrequency="0.1"
                        Value="{x:Bind ViewModel.MinSizeScanDistanceScaleFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <settingsControls:SettingsCard x:Uid="SettingsPage_QRPaddingSettingsCard" Description="{x:Bind ViewModel.QrPaddingSettingsDescription, Mode=OneWay}">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <controls:RulerIcon />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <Slider
                        MinWidth="200"
                        IsThumbToolTipEnabled="False"
                        Maximum="10"
                        Minimum="0"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.QrPaddingModules, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </settingsControls:SettingsCard>

                <!--  Quick save location  -->
                <settingsControls:SettingsExpander x:Uid="SettingsPage_QuickSaveLocationSettingsExpander">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xED25;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_FolderSettingsCard">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox
                                    x:Uid="SettingsPage_NoFolderSelectedTextBox"
                                    MinWidth="250"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.QuickSaveLocation, Mode=OneWay}" />
                                <Button x:Uid="SettingsPage_BrowseButton" Command="{x:Bind ViewModel.BrowseQuickSaveLocationCommand}" />
                                <Button
                                    x:Uid="SettingsPage_ClearButton"
                                    Command="{x:Bind ViewModel.ClearQuickSaveLocationCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasQuickSaveLocation, Mode=OneWay}" />
                            </StackPanel>
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  Defaults  -->
                <TextBlock
                    x:Uid="SettingsPage_DefaultsText"
                    Margin="0,16,0,4"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <settingsControls:SettingsExpander x:Uid="SettingsPage_QRCodeDefaultsSettingsExpander" IsExpanded="True">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE713;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>

                        <!--  Default foreground color  -->
                        <settingsControls:SettingsCard x:Uid="SettingsPage_CodeColorSettingsCard" Description="{x:Bind ViewModel.DefaultForegroundColorText, Mode=OneWay}">
                            <settingsControls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </settingsControls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Width="24"
                                    Height="24"
                                    Background="{x:Bind ViewModel.DefaultForegroundColorBrush, Mode=OneWay}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <Button
                                    x:Uid="SettingsPage_ResetButton"
                                    Command="{x:Bind ViewModel.ResetForegroundDefaultCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasDefaultForegroundColor, Mode=OneWay}" />
                            </StackPanel>
                        </settingsControls:SettingsCard>

                        <!--  Default background color  -->
                        <settingsControls:SettingsCard x:Uid="SettingsPage_BackgroundColorSettingsCard" Description="{x:Bind ViewModel.DefaultBackgroundColorText, Mode=OneWay}">
                            <settingsControls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE771;" />
                            </settingsControls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Width="24"
                                    Height="24"
                                    Background="{x:Bind ViewModel.DefaultBackgroundColorBrush, Mode=OneWay}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <Button
                                    x:Uid="SettingsPage_ResetButton2"
                                    Command="{x:Bind ViewModel.ResetBackgroundDefaultCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasDefaultBackgroundColor, Mode=OneWay}" />
                            </StackPanel>
                        </settingsControls:SettingsCard>

                        <!--  Default error correction  -->
                        <settingsControls:SettingsCard x:Uid="SettingsPage_ErrorCorrectionSettingsCard" Description="{x:Bind ViewModel.DefaultErrorCorrectionText, Mode=OneWay}">
                            <settingsControls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xEBE8;" />
                            </settingsControls:SettingsCard.HeaderIcon>
                            <Button
                                x:Uid="SettingsPage_ResetButton3"
                                Command="{x:Bind ViewModel.ResetErrorCorrectionDefaultCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDefaultErrorCorrection, Mode=OneWay}" />
                        </settingsControls:SettingsCard>

                        <!--  Default frame  -->
                        <settingsControls:SettingsCard x:Uid="SettingsPage_FrameAndPatternSettingsCard" Description="{x:Bind ViewModel.DefaultFramePresetText, Mode=OneWay}">
                            <settingsControls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8BC;" />
                            </settingsControls:SettingsCard.HeaderIcon>
                            <Button
                                x:Uid="SettingsPage_ResetButton4"
                                Command="{x:Bind ViewModel.ResetFramePresetDefaultCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDefaultFramePreset, Mode=OneWay}" />
                        </settingsControls:SettingsCard>

                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  Data Import/Export  -->
                <TextBlock
                    x:Uid="SettingsPage_DataText"
                    Margin="0,16,0,4"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!--  Export  -->
                <settingsControls:SettingsExpander x:Uid="SettingsPage_ExportSettingsExpander" IsExpanded="True">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE898;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <Button x:Uid="SettingsPage_ExportButton" Command="{x:Bind ViewModel.ExportSettingsCommand}" />
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_IncludeSettingsSettingsCard">
                            <settingsControls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE713;" />
                            </settingsControls:SettingsCard.HeaderIcon>
                            <CheckBox IsChecked="{x:Bind ViewModel.ExportIncludeSettings, Mode=TwoWay}" />
                        </settingsControls:SettingsCard>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_IncludeBrandsSettingsCard">
                            <settingsControls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8F9;" />
                            </settingsControls:SettingsCard.HeaderIcon>
                            <CheckBox IsChecked="{x:Bind ViewModel.ExportIncludeBrands, Mode=TwoWay}" />
                        </settingsControls:SettingsCard>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_IncludeHistorySettingsCard">
                            <settingsControls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE81C;" />
                            </settingsControls:SettingsCard.HeaderIcon>
                            <CheckBox IsChecked="{x:Bind ViewModel.ExportIncludeHistory, Mode=TwoWay}" />
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  Import  -->
                <settingsControls:SettingsCard x:Uid="SettingsPage_ImportSettingsCard">
                    <settingsControls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </settingsControls:SettingsCard.HeaderIcon>
                    <Button x:Uid="SettingsPage_ImportButton" Command="{x:Bind ViewModel.ImportSettingsCommand}" />
                </settingsControls:SettingsCard>

                <InfoBar
                    x:Name="ImportExportInfoBar"
                    Closed="ImportExportInfoBar_Closed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasImportExportStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ImportExportStatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.ImportExportStatusSeverity, Mode=OneWay}" />

                <!--  About  -->
                <TextBlock
                    x:Uid="Settings_About"
                    Margin="0,16,0,4"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <settingsControls:SettingsExpander x:Uid="SettingsPage_SimpleQRCodeMakerSettingsExpander" Description="{x:Bind ViewModel.VersionDescription, Mode=OneWay}">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_PrivacySettingsCard">
                            <HyperlinkButton x:Uid="SettingsPage_PrivacyTermsLink" NavigateUri="https://github.com/TheJoeFin/Simple-QR-Code-Maker/blob/master/PRIVACY" />
                        </settingsControls:SettingsCard>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_LearnMoreSettingsCard">
                            <HyperlinkButton x:Uid="SettingsPage_QRCodesOnWikipediaHyperlinkButton" Command="{x:Bind ViewModel.GoToMoreInfoCommand}" />
                        </settingsControls:SettingsCard>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_RateThisAppSettingsCard">
                            <HyperlinkButton x:Uid="SettingsPage_MicrosoftStoreHyperlinkButton" Command="{x:Bind ViewModel.ReviewAppCommand}" />
                        </settingsControls:SettingsCard>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_SourceCodeSettingsCard">
                            <HyperlinkButton x:Uid="SettingsPage_GitHubHyperlinkButton" NavigateUri="https://github.com/TheJoeFin/Simple-QR-Code-Maker" />
                        </settingsControls:SettingsCard>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_CreatedBySettingsCard">
                            <HyperlinkButton x:Uid="SettingsPage_TheJoeFinHyperlinkButton" NavigateUri="https://github.com/TheJoeFin" />
                        </settingsControls:SettingsCard>
                    </settingsControls:SettingsExpander.Items>
                </settingsControls:SettingsExpander>

                <!--  More Apps  -->
                <settingsControls:SettingsExpander x:Uid="SettingsPage_MoreAppsByTheJoeFinSettingsExpander" IsExpanded="True">
                    <settingsControls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </settingsControls:SettingsExpander.HeaderIcon>
                    <settingsControls:SettingsExpander.Items>
                        <settingsControls:SettingsCard x:Uid="SettingsPage_SimpleIconFileMakerSettingsCard">
