<Page
    x:Class="Simple_QR_Code_Maker.Views.DecodingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Simple_QR_Code_Maker.Behaviors"
    xmlns:controls="using:Simple_QR_Code_Maker.Controls"
    xmlns:converters="using:Simple_QR_Code_Maker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    x:Name="DecodingPageRoot"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="V"
            Invoked="PasteKeyboardAccelerator_Invoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <converters:TextHasURLConverter x:Key="HasURL" />
        <converters:NoCodesWarningVisibilityConverter x:Key="NoCodesWarningVisibilityConverter" />
        <converters:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <!--  FAQ pane (left overlay)  -->
    <SplitView
        DisplayMode="Overlay"
        IsPaneOpen="{x:Bind ViewModel.IsFaqPaneOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        OpenPaneLength="500"
        PanePlacement="Left">
        <SplitView.Pane>
            <controls:FaqsContent />
        </SplitView.Pane>
        <SplitView.Content>

            <!--  Decoding History pane (right overlay)  -->
            <SplitView
                DisplayMode="Overlay"
                IsPaneOpen="{x:Bind ViewModel.IsDecodingHistoryPaneOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                OpenPaneLength="360"
                PanePlacement="Right">
                <SplitView.Pane>
                    <controls:DecodingHistoryPaneContentControl ViewModel="{x:Bind ViewModel}" />
                </SplitView.Pane>
                <SplitView.Content>

                    <!--  Folder / Cut-Out Images pane (left inline, 280px)  -->
                    <SplitView
                        DisplayMode="Inline"
                        IsPaneOpen="{x:Bind ViewModel.IsLeftPaneOpen, Mode=OneWay}"
                        OpenPaneLength="280"
                        PanePlacement="Left">
                        <SplitView.Pane>
                            <Grid>
                                <controls:FolderPaneContentControl ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.IsFolderPaneOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <controls:CutOutImagesPaneContentControl ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.IsCutOutImagesPaneOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </SplitView.Pane>
                        <SplitView.Content>

                            <!--  Advanced Tools pane (right inline)  -->
                            <SplitView
                                DisplayMode="Inline"
                                IsPaneOpen="{x:Bind ViewModel.IsSidePaneOpen, Mode=OneWay}"
                                OpenPaneLength="350"
                                PanePlacement="Right">
                                <SplitView.Pane>
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                        <Grid>
                                            <Border Visibility="{x:Bind ViewModel.IsAdvancedToolsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <controls:AdvancedToolsUserControl x:Name="AdvancedToolsPanel" />
                                            </Border>
                                            <Button
                                                x:Uid="DecodingPage_CloseAdvancedToolsButton"
                                                Width="32"
                                                Height="32"
                                                Margin="0,28,20,0"
                                                Padding="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Command="{x:Bind ViewModel.ToggleAdvancedToolsCommand}"
                                                Visibility="{x:Bind ViewModel.IsAdvancedToolsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Viewbox>
                                                    <SymbolIcon Symbol="ClosePane" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </SplitView.Pane>

                                <SplitView.Content>
                                    <Grid>
                                        <!--  Loading Overlay  -->
                                        <Grid
                                            x:Name="LoadingOverlay"
                                            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                            Canvas.ZIndex="100"
                                            IsHitTestVisible="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                            Opacity="0.92"
                                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <interactivity:Interaction.Behaviors>
                                                <behaviors:ImplicitVisibilityAnimationBehavior />
                                            </interactivity:Interaction.Behaviors>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="12" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="12">
                                                <ProgressRing
                                                    x:Name="LoadingProgressRing"
                                                    Width="100"
                                                    Height="100"
                                                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                                                <TextBlock
                                                    x:Name="LoadingMessageTextBlock"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" />
                                                <Button
                                                    x:Uid="DecodingPage_CancelButton"
                                                    HorizontalAlignment="Center"
                                                    Command="{x:Bind ViewModel.CancelBatchOperationCommand, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.IsCancellableOperationRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid
                                            Name="BaseGrid"
                                            HorizontalAlignment="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource BoolToAlignmentConverter}}"
                                            VerticalAlignment="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource BoolToAlignmentConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition x:Name="TopSpacerRow" Height="Auto" />
                                                <RowDefinition x:Name="ImageRow" Height="Auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel
                                                Margin="10"
                                                Orientation="Vertical"
                                                Spacing="10"
                                                Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                                <interactivity:Interaction.Behaviors>
                                                    <behaviors:ImplicitVisibilityAnimationBehavior />
                                                </interactivity:Interaction.Behaviors>

                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="10">
                                                    <controls:IconAndTextButton
                                                        x:Uid="DecodingPage_OpenFilesIconAndTextButton"
                                                        Width="140"
                                                        Command="{x:Bind ViewModel.OpenNewFileCommand}"
                                                        IsEnabled="{x:Bind ViewModel.OpenNewFileCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                                        Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, ConverterParameter=true, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <controls:IconAndTextButton.IconSource>
                                                            <SymbolIconSource Symbol="OpenFile" />
                                                        </controls:IconAndTextButton.IconSource>
                                                    </controls:IconAndTextButton>
                                                    <controls:IconAndTextButton
                                                        x:Uid="DecodingPage_OpenFolderIconAndTextButton"
                                                        Width="150"
                                                        Command="{x:Bind ViewModel.OpenFolderCommand}"
                                                        IsEnabled="{x:Bind ViewModel.OpenFolderCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                                        Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, ConverterParameter=true, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <controls:IconAndTextButton.IconSource>
                                                            <SymbolIconSource Symbol="Folder" />
                                                        </controls:IconAndTextButton.IconSource>
                                                    </controls:IconAndTextButton>
                                                </StackPanel>

                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="10">
                                                    <controls:IconAndTextButton
                                                        x:Uid="DecodingPage_PasteIconAndTextButton"
                                                        Width="85"
                                                        Click="PasteImageButton_Click"
                                                        IsEnabled="{x:Bind ViewModel.CanPasteImage, Mode=OneWay}">
                                                        <controls:IconAndTextButton.IconSource>
                                                            <SymbolIconSource Symbol="Paste" />
                                                        </controls:IconAndTextButton.IconSource>
                                                    </controls:IconAndTextButton>
                                                    <controls:IconAndTextButton
                                                        x:Uid="DecodingPage_CameraIconAndTextButton"
                                                        Width="110"
                                                        Command="{x:Bind ViewModel.CapturePhotoCommand}"
                                                        IsEnabled="{x:Bind ViewModel.CapturePhotoCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                                        <controls:IconAndTextButton.IconSource>
                                                            <SymbolIconSource Symbol="Camera" />
                                                        </controls:IconAndTextButton.IconSource>
                                                    </controls:IconAndTextButton>
                                                    <controls:IconAndTextButton
                                                        x:Uid="DecodingPage_SnipIconAndTextButton"
                                                        Width="85"
                                                        Command="{x:Bind ViewModel.LaunchSnippingToolCommand}"
                                                        IsEnabled="{x:Bind ViewModel.LaunchSnippingToolCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                                        <controls:IconAndTextButton.IconSource>
                                                            <SymbolIconSource Symbol="Trim" />
                                                        </controls:IconAndTextButton.IconSource>
                                                    </controls:IconAndTextButton>
                                                </StackPanel>
                                            </StackPanel>

                                            <Grid
                                                x:Name="DropContainer"
                                                Grid.Row="1"
                                                AllowDrop="True"
                                                DragOver="DropContainer_DragOver"
                                                Drop="DropContainer_Drop">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Margin="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <interactivity:Interaction.Behaviors>
                                                        <behaviors:ImplicitVisibilityAnimationBehavior />
                                                    </interactivity:Interaction.Behaviors>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyLargeTextBlockStyle}"
                                                        Text="{x:Bind ViewModel.CurrentImageTitle, Mode=OneWay}" />
                                                    <DropDownButton>
                                                        <DropDownButton.Content>
                                                            <SymbolIcon Symbol="More" />
                                                        </DropDownButton.Content>
                                                        <DropDownButton.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    x:Uid="DecodingPage_OpenFileMenuItem"
                                                                    Command="{x:Bind ViewModel.OpenCurrentSourceFileCommand}"
                                                                    Visibility="{x:Bind ViewModel.CanOpenCurrentSourceFile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="OpenFile" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    x:Uid="DecodingPage_SaveImageMenuItem"
                                                                    Command="{x:Bind ViewModel.SaveCurrentDecodedImageCommand}"
                                                                    Visibility="{x:Bind ViewModel.CanSaveCurrentDecodedImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Save" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    x:Uid="DecodingPage_OpenContainingFolderMenuItem"
                                                                    Command="{x:Bind ViewModel.OpenCurrentContainingFolderCommand}"
                                                                    Visibility="{x:Bind ViewModel.CanOpenCurrentContainingFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Folder" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </DropDownButton.Flyout>
                                                    </DropDownButton>
                                                </StackPanel>

                                                <Grid Grid.Row="1">
                                                    <Border
                                                        Width="300"
                                                        Height="300"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind ViewModel.HasActivePreviewSurface, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                                        <interactivity:Interaction.Behaviors>
                                                            <behaviors:ImplicitVisibilityAnimationBehavior />
                                                        </interactivity:Interaction.Behaviors>
                                                        <StackPanel
                                                            Padding="40"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.7"
                                                            Spacing="12"
                                                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                                            <Viewbox Height="100">
                                                                <controls:ScanIcon />
                                                            </Viewbox>
                                                            <TextBlock
                                                                x:Uid="DecodingPage_OpenPasteDropAnImageText"
                                                                HorizontalAlignment="Center"
                                                                TextAlignment="Center"
                                                                TextWrapping="WrapWholeWords"
                                                                Visibility="Collapsed" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Grid
                                                        MinWidth="300"
                                                        MinHeight="300"
                                                        Margin="0"
                                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind ViewModel.HasActivePreviewSurface, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <interactivity:Interaction.Behaviors>
                                                            <behaviors:ImplicitVisibilityAnimationBehavior />
                                                        </interactivity:Interaction.Behaviors>
                                                        <ScrollView
                                                            x:Name="ImageScrollView"
                                                            ContentOrientation="None"
                                                            HorizontalScrollBarVisibility="Auto"
                                                            MaxZoomFactor="10"
                                                            MinZoomFactor="0.9"
                                                            VerticalScrollBarVisibility="Auto"
                                                            ZoomMode="Enabled">
                                                            <Viewbox Stretch="Uniform">

                                                                <Grid
                                                                    x:Name="ImageContainer"
                                                                    PointerEntered="ImageContainer_PointerEntered"
                                                                    PointerExited="ImageContainer_PointerExited"
                                                                    PointerMoved="ImageContainer_PointerMoved"
                                                                    PointerPressed="ImageContainer_PointerPressed"
                                                                    PointerReleased="ImageContainer_PointerReleased">
                                                                    <Image
                                                                        x:Name="ImageWithBarcodes"
                                                                        Width="{x:Bind ViewModel.CurrentDecodingItem.ImagePixelWidth, Mode=OneWay}"
                                                                        Height="{x:Bind ViewModel.CurrentDecodingItem.ImagePixelHeight, Mode=OneWay}"
                                                                        Source="{x:Bind ViewModel.CurrentDecodingItem.BitmapImage, Mode=OneWay}" />
                                                                    <ItemsControl
                                                                        Width="{x:Bind ViewModel.CurrentDecodingItem.ImagePixelWidth, Mode=OneWay}"
                                                                        Height="{x:Bind ViewModel.CurrentDecodingItem.ImagePixelHeight, Mode=OneWay}"
                                                                        ItemsSource="{x:Bind ViewModel.CurrentDecodingItem.CodeBorders, Mode=OneWay}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <Canvas />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="controls:TextBorder">
                                                                                <ContentControl Content="{x:Bind}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <ItemsControl
                                                                        Width="{x:Bind ViewModel.CurrentDecodingItem.ImagePixelWidth, Mode=OneWay}"
                                                                        Height="{x:Bind ViewModel.CurrentDecodingItem.ImagePixelHeight, Mode=OneWay}"
                                                                        IsHitTestVisible="False"
                                                                        ItemsSource="{x:Bind ViewModel.CurrentDecodingItem.PerspectiveCornerMarkers, Mode=OneWay}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <Canvas />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="FrameworkElement">
                                                                                <ContentControl Content="{x:Bind}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <!--  Selection rectangle for Cut Out Region tool  -->
                                                                    <Canvas
                                                                        x:Name="SelectionCanvas"
                                                                        Width="{x:Bind ViewModel.CurrentDecodingItem.ImagePixelWidth, Mode=OneWay}"
                                                                        Height="{x:Bind ViewModel.CurrentDecodingItem.ImagePixelHeight, Mode=OneWay}"
                                                                        IsHitTestVisible="False">
                                                                        <Rectangle
                                                                            x:Name="SelectionRectangle"
                                                                            Fill="#220078D4"
                                                                            Stroke="#FF0078D4"
                                                                            StrokeDashArray="6,3"
                                                                            StrokeThickness="3"
                                                                            Visibility="Collapsed" />
                                                                    </Canvas>
                                                                </Grid>
                                                            </Viewbox>
                                                        </ScrollView>
                                                    </Grid>
                                                </Grid>
                                                <!--  Warning InfoBar (below image, shown when no codes found)  -->
                                                <InfoBar
                                                    x:Name="NoCodesInfoBar"
                                                    x:Uid="DecodingPage_NoCodesInfoBar"
                                                    Grid.Row="1"
                                                    MaxWidth="400"
                                                    Margin="20,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    IsClosable="True"
                                                    IsOpen="{x:Bind ViewModel.CurrentDecodingItem.CodeBorders.Count, Mode=OneWay, Converter={StaticResource NoCodesWarningVisibilityConverter}}"
                                                    Severity="Warning"
                                                    Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Margin="0,0,0,12" Spacing="8">
                                                        <TextBlock
                                                            x:Uid="DecodingPage_UseAdvancedToolsToOpenText"
                                                            IsTextSelectionEnabled="True"
                                                            TextWrapping="Wrap" />
                                                        <HyperlinkButton
                                                            x:Uid="DecodingPage_DetectionHelpLink"
                                                            Padding="0"
                                                            Command="{x:Bind ViewModel.OpenDetectionFaqCommand}" />
                                                    </StackPanel>
                                                </InfoBar>
                                            </Grid>

                                            <StackPanel
                                                x:Name="ActionButtonsPanel"
                                                Grid.Row="2"
                                                Margin="10"
                                                HorizontalAlignment="Center"
                                                Orientation="Vertical"
                                                SizeChanged="ActionButtonsPanel_SizeChanged"
                                                Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <controls:IconAndTextButton
                                                        x:Uid="DecodingPage_MakeCodesIconAndTextButton"
                                                        Command="{x:Bind ViewModel.GoToCreateQrCodesCommand}"
                                                        Visibility="{x:Bind ViewModel.ShowMainNavigationButtons, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <controls:IconAndTextButton.Icon>
                                                            <controls:QrCodeIcon />
                                                        </controls:IconAndTextButton.Icon>
                                                    </controls:IconAndTextButton>
                                                    <controls:IconAndTextButton
                                                        x:Uid="DecodingPage_SettingsIconAndTextButton"
                                                        Command="{x:Bind ViewModel.GoToSettingsCommand}"
                                                        Visibility="{x:Bind ViewModel.ShowMainNavigationButtons, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <controls:IconAndTextButton.Icon>
                                                            <SymbolIcon Symbol="Setting" />
                                                        </controls:IconAndTextButton.Icon>
                                                    </controls:IconAndTextButton>

                                                    <DropDownButton
                                                        Name="NewDropDownButton"
                                                        x:Uid="DecodingPage_NewDropDownButton"
                                                        Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <DropDownButton.Content>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Uid="DecodingPage_NewText" />
                                                            </StackPanel>
                                                        </DropDownButton.Content>
                                                        <DropDownButton.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    x:Uid="DecodingPage_OpenFilesMenuItem"
                                                                    Command="{x:Bind ViewModel.OpenNewFileCommand}"
                                                                    IsEnabled="{x:Bind ViewModel.OpenNewFileCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="OpenFile" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    x:Uid="DecodingPage_OpenFolderMenuItem"
                                                                    Command="{x:Bind ViewModel.OpenFolderCommand}"
                                                                    IsEnabled="{x:Bind ViewModel.OpenFolderCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Folder" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    x:Uid="DecodingPage_PasteMenuItem"
                                                                    Click="PasteImageButton_Click"
                                                                    IsEnabled="{x:Bind ViewModel.CanPasteImage, Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Paste" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    x:Uid="DecodingPage_CameraMenuItem"
                                                                    Command="{x:Bind ViewModel.CapturePhotoCommand}"
                                                                    IsEnabled="{x:Bind ViewModel.CapturePhotoCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Camera" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    x:Uid="DecodingPage_SnipMenuItem"
                                                                    Command="{x:Bind ViewModel.LaunchSnippingToolCommand}"
                                                                    IsEnabled="{x:Bind ViewModel.LaunchSnippingToolCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Trim" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </DropDownButton.Flyout>
                                                    </DropDownButton>
                                                    <ToggleButton
                                                        x:Uid="DecodingPage_ShowOrHideAdvancedImageToggleButton"
                                                        IsChecked="{x:Bind ViewModel.IsAdvancedToolsVisible, Mode=TwoWay}"
                                                        Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <SymbolIcon Symbol="Repair" />
                                                            <TextBlock x:Uid="DecodingPage_AdvancedToolsText" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </StackPanel>
                                            </StackPanel>

                                            <InfoBar
                                                x:Name="QrCodeInfoBar"
                                                Title="{x:Bind ViewModel.DecodedContentInfoBarTitle, Mode=OneWay}"
                                                Grid.Row="1"
                                                Margin="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderThickness="3"
                                                IsOpen="{x:Bind ViewModel.IsInfoBarShowing, Mode=TwoWay}"
                                                Severity="{x:Bind ViewModel.DecodedContentInfoBarSeverity, Mode=OneWay}">
                                                <StackPanel
                                                    Margin="12,0"
                                                    Orientation="Vertical"
                                                    Spacing="12">
                                                    <TextBlock
                                                        MaxWidth="500"
                                                        VerticalAlignment="Center"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        MaxWidth="500"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind ViewModel.RedirectorWarningMessage, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind ViewModel.IsRedirectorWarningVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="12">
                                                        <AppBarButton
                                                            x:Uid="DecodingPage_EditThisTextAsAAppBarButton"
                                                            Command="{x:Bind ViewModel.EditQrCodeCommand}"
                                                            Icon="Edit"
                                                            IsCompact="True" />
                                                        <AppBarButton
                                                            x:Uid="DecodingPage_CopyTheEncodedTextToAppBarButton"
                                                            Command="{x:Bind ViewModel.AddMessageToClipboardCommand}"
                                                            Icon="Copy"
                                                            IsCompact="True" />
                                                        <AppBarButton
                                                            x:Uid="DecodingPage_TryToGoToTheAppBarButton"
                                                            Command="{x:Bind ViewModel.TryLaunchLinkCommand}"
                                                            Icon="Go"
                                                            IsCompact="True"
                                                            IsEnabled="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay, Converter={StaticResource HasURL}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </InfoBar>

                                        </Grid>

                                        <!--  Images panel toggle button (top left)  -->
                                        <AppBarButton
                                            x:Uid="DecodingPage_ShowHideImagesPanelAppBarButton"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Command="{x:Bind ViewModel.ToggleLeftPaneCommand}"
                                            IsCompact="True"
                                            Visibility="{x:Bind ViewModel.HasLeftPaneContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <SymbolIcon Symbol="Pictures" />
                                        </AppBarButton>
                                    </Grid>
                                </SplitView.Content>
                            </SplitView>

                        </SplitView.Content>
                    </SplitView>

                </SplitView.Content>
            </SplitView>

        </SplitView.Content>
    </SplitView>
</Page>
